---
import { cn } from '@/lib/cn'

interface Props {
	class?: string
	reveal?: boolean
}

const { class: className, reveal = true } = Astro.props as Props
---

{reveal
	? (
			<div class={cn('article-body', className)} data-article-reveal>
				<slot />
			</div>
		)
	: (
			<div class={cn('article-body', className)} data-article-plain>
				<slot />
			</div>
		)}

<script>
import { attachArticlePhotoswipe } from '@/lib/photoswipe-gallery'

const TOP_SCROLL_PX = 16

function setupReveal(root: HTMLElement) {
	const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches
	if (reduce) {
		for (const el of [...root.children])
			el.classList.add('article-reveal-done')
		return
	}

	const atTop = window.scrollY <= TOP_SCROLL_PX
	const vh = window.visualViewport?.height ?? window.innerHeight
	const pad = 48

	const revealEl = (el: Element) => {
		el.classList.remove('article-reveal-pending')
		el.classList.add('article-reveal-done')
	}

	const io = new IntersectionObserver(
		(entries) => {
			for (const e of entries) {
				if (e.isIntersecting) {
					revealEl(e.target)
					io.unobserve(e.target)
				}
			}
		},
		{ root: null, rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
	)

	let topRank = 0
	for (const child of [...root.children]) {
		const el = child as HTMLElement
		const r = el.getBoundingClientRect()
		const intersects = r.top < vh + pad && r.bottom > -pad
		const belowFold = r.top > vh - 8
		const aboveViewport = r.bottom < 8

		if (!atTop && intersects) {
			el.classList.add('article-reveal-skip')
			el.classList.add('article-reveal-done')
			continue
		}
		if (!atTop && aboveViewport) {
			el.classList.add('article-reveal-skip')
			el.classList.add('article-reveal-done')
			continue
		}
		if (!atTop && belowFold) {
			el.classList.add('article-reveal-pending')
			io.observe(el)
			continue
		}

		if (atTop && belowFold) {
			el.classList.add('article-reveal-pending')
			io.observe(el)
			continue
		}

		if (atTop && intersects) {
			el.style.setProperty('--article-reveal-delay', `${topRank * 48}ms`)
			topRank++
			el.classList.add('article-reveal-stagger')
			continue
		}

		el.classList.add('article-reveal-pending')
		io.observe(el)
	}
}

for (const root of document.querySelectorAll<HTMLElement>('[data-article-reveal]')) {
	if (root.dataset.articleInit === '1')
		continue
	root.dataset.articleInit = '1'
	setupReveal(root)
	attachArticlePhotoswipe(root)
}

for (const root of document.querySelectorAll<HTMLElement>('[data-article-plain]')) {
	if (root.dataset.articleInit === '1')
		continue
	root.dataset.articleInit = '1'
	attachArticlePhotoswipe(root)
}
</script>
