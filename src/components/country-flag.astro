---
interface Props {
	code: null | string
}

const { code } = Astro.props as Props

const flagSvgs = import.meta.glob<string>('../assets/flags/*.svg', {
	eager: true,
	import: 'default',
	query: '?raw',
})

const iso = code?.trim().toUpperCase()
const svg = iso ? flagSvgs[`../assets/flags/${iso.toLowerCase()}.svg`] : null
---

{svg
	? (
			<span
				class="
					inline-flex h-[1em] w-[1.33em] shrink-0 items-center leading-none
					[&_svg]:block [&_svg]:size-full
				"
				aria-hidden="true"
				set:html={svg}
			/>
		)
	: null}
