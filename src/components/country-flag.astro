---
import { renderNucleoFlagSvg } from '@/lib/render-nucleo-flag'

interface Props {
	code: null | string
}

const { code } = Astro.props as Props

const svg = code ? await renderNucleoFlagSvg(code.toUpperCase(), '1em') : null
---

{svg
	? (
			<span
				class="
					inline-flex h-[1em] w-[1.33em] shrink-0 items-center leading-none
					[&_svg]:block [&_svg]:size-full
				"
				aria-hidden="true"
				set:html={svg}
			/>
		)
	: null}
