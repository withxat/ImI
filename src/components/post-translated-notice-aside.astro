---
import type { PostTranslatedNoticeCopy } from '@/lib/i18n/messages'
import type { Translator } from '@/types/translator'

import PostTranslatorTitle from '@/components/post-translator-title.astro'
import { buildLocaleSwitchHref } from '@/lib/i18n/locale-switch'

const ZH_LINK_LABEL = '中文'

interface Props {
	notice: PostTranslatedNoticeCopy
	translator?: Translator
}

const { notice, translator } = Astro.props as Props
const { pathname, search } = Astro.url
const switchToZhHref = buildLocaleSwitchHref(pathname, search, 'zh')
---

<aside
	class="surface-callout px-4 py-3 font-ui text-sm/relaxed text-muted-foreground"
	role="note"
>
	{translator ? <PostTranslatorTitle translator={translator} /> : null}
	{notice.beforeLink}
	<a class="text-link" href={switchToZhHref} lang="zh" data-astro-reload>
		{ZH_LINK_LABEL}
	</a>
	{notice.afterLink}
</aside>
