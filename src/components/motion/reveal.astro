---

interface Props {
	baseDelay?: number
	blur?: number
	class?: string
	staggerIndex?: number
	staggerStep?: number
	y?: number
}

const {
	baseDelay = 0.06,
	blur = 10,
	class: className,
	staggerIndex = 0,
	staggerStep = 0.048,
	y = 10,
} = Astro.props as Props
---

<div
	class={className}
	data-reveal-blur={blur}
	data-reveal-pending=""
	data-reveal-pending-base-delay={baseDelay}
	data-reveal-stagger-index={staggerIndex}
	data-reveal-stagger-step={staggerStep}
	data-reveal-y={y}
	style={`--reveal-blur: ${blur}px; --reveal-y: ${y}px; opacity: 0; filter: blur(${blur}px); transform: translate3d(0, ${y}px, 0); transition-property: opacity, filter, transform; transition-duration: 420ms; transition-timing-function: cubic-bezier(0.22, 1, 0.36, 1);`}
	data-reveal
>
	<slot />
</div>
