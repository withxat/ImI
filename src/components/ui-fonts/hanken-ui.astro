---
/** English UI stack — Hanken Grotesk only (no MiSans subset). */
const stack = '"Hanken Grotesk", ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif'
const rootFontCss = `:root {
  --font-display: ${stack};
  --font-text: ${stack};
  --font-ui: ${stack};
}`
---

<style set:html={rootFontCss} is:global />
