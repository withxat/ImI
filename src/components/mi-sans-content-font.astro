---
import type { Locale } from '@/lib/i18n/constants'

import { localeUsesCjkUiFont } from '@/lib/i18n/locale-switch'

interface Props {
	locale: Locale
}

const { locale } = Astro.props as Props

if (localeUsesCjkUiFont(locale)) {
	await import('@/assets/mi-sans-vf.ttf?subsets&key=content')
}
---
