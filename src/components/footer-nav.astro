---
import Dot from '~icons/lucide/dot'

const LINKS = [
	{ href: 'https://github.com/withxat', label: 'GitHub' },
	{ href: 'https://x.com/withxat', label: 'Twitter' },
	{ href: 'https://t.me/withxat', label: 'Telegram' },
	{ href: 'mailto:i@xat.sh', label: 'Email' },
] as const
---

<nav class="flex flex-wrap items-center gap-x-2 gap-y-1 font-ui text-sm">
	{LINKS.map((item, index) => (
		<>
			{index > 0 && (
				<Dot class="size-3 shrink-0 text-muted-foreground opacity-70" aria-hidden />
			)}
			<a
				class="text-link"
				href={item.href}
				rel={item.href.startsWith('mailto:') ? undefined : 'noreferrer'}
				target={item.href.startsWith('mailto:') ? undefined : '_blank'}
			>
				{item.label}
			</a>
		</>
	))}
</nav>
