---
import { cn } from '@/lib/cn'

type Props = {
	class?: string
} & (
	| { decorative: true, href?: never }
	| { decorative?: false, href: string }
)

const { class: className, decorative = false, href } = Astro.props as Props

// Stay inline: the pill underline relies on `box-decoration-break: clone` to draw per line,
// which an inline-flex box would collapse into one underline under the whole block.
const linkClass = cn('text-link font-ui text-sm', className)
---

{decorative
	? (
			<span class={cn(linkClass, 'cursor-pointer')}>
				<slot />
			</span>
		)
	: (
			<a
				class={linkClass}
				href={href}
				data-astro-prefetch
			>
				<slot />
			</a>
		)}
