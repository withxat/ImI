---
import { cn } from '@/lib/cn'

type Props = {
	class?: string
} & (
	| { decorative: true, href?: never }
	| { decorative?: false, href: string }
)

const { class: className, decorative = false, href } = Astro.props as Props

const linkClass = cn('text-link inline-flex items-center gap-2 font-ui text-sm', className)
---

{decorative
	? (
			<span class={cn(linkClass, 'cursor-pointer')}>
				<slot />
			</span>
		)
	: (
			<a
				class={linkClass}
				href={href}
				data-astro-prefetch
			>
				<slot />
			</a>
		)}
