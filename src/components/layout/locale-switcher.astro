---
import type { Locale } from '@/lib/i18n/constants'

import Dot from '~icons/lucide/dot'

import { LOCALES } from '@/lib/i18n/constants'
import { buildLocaleSwitchHref } from '@/lib/i18n/locale-switch'

interface Props {
	'aria-label': string
	'class'?: string
	'currentLocale': Locale
}

const LOCALE_LABEL: Record<Locale, string> = {
	en: 'EN',
	ja: '日本語',
	zh: '中文',
}

const { 'aria-label': ariaLabel, class: className, currentLocale } = Astro.props as Props
const { pathname, search } = Astro.url
---

<div aria-label={ariaLabel} class={className} role="navigation">
	<p class="flex flex-wrap items-center gap-x-2 gap-y-1 font-ui text-sm text-muted-foreground">
		{LOCALES.map((locale, index) => (
			<>
				{index > 0 && (
					<Dot aria-hidden="true" class="size-3 shrink-0 text-muted-foreground opacity-70" />
				)}
				{locale === currentLocale
					? (
							<span class="font-medium whitespace-nowrap text-highlight-strong" lang={locale}>
								{LOCALE_LABEL[locale]}
							</span>
						)
					: (
							<a
								class="text-link-muted whitespace-nowrap"
								data-astro-prefetch="tap"
								href={buildLocaleSwitchHref(pathname, search, locale)}
								lang={locale}
							>
								{LOCALE_LABEL[locale]}
							</a>
						)}
			</>
		))}
	</p>
</div>
