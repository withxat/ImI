---
import Copy from '~icons/lucide/copy'
import Dot from '~icons/lucide/dot'

interface Props {
	copyEmailLabel: string
	emailCopiedLabel: string
	resumeLabel: string
}

const { copyEmailLabel, emailCopiedLabel, resumeLabel } = Astro.props as Props
const EMAIL = 'i@xat.sh'

const LINKS = [
	{ href: 'https://github.com/withxat', label: 'GitHub' },
	{ href: 'https://x.com/withxat', label: 'Twitter' },
	{ href: 'https://t.me/withxat', label: 'Telegram' },
	{ href: `mailto:${EMAIL}`, label: 'Email' },
	{ href: '/resume', label: resumeLabel },
]
---

<nav class="flex flex-wrap items-center gap-2 font-ui text-sm">
	{LINKS.map((item, index) => {
		const external = item.href.startsWith('https:')
		const link = (
			<a
				class="text-link"
				data-astro-prefetch={item.href.startsWith('/') ? '' : undefined}
				href={item.href}
				rel={external ? 'noreferrer' : undefined}
				target={external ? '_blank' : undefined}
			>
				{item.label}
			</a>
		)
		return (
			<>
				{index > 0 && (
					<Dot aria-hidden="true" class="size-3 shrink-0 text-muted-foreground opacity-70" />
				)}
				{item.href.startsWith('mailto:')
					? (
							<span class="email-copy flex items-center" data-email-copy={EMAIL}>
								{link}
								<span class="email-copy-slot" data-email-copy-slot>
									<button aria-label={copyEmailLabel} class="email-copy-button" type="button" data-email-copy-button>
										<Copy aria-hidden="true" class="size-3.5" />
									</button>
									<span
										aria-live="polite"
										class="bubble bubble-top"
										data-copied-label={emailCopiedLabel}
										role="status"
										data-email-copy-bubble
									>
									</span>
								</span>
							</span>
						)
					: link}
			</>
		)
	})}
</nav>
