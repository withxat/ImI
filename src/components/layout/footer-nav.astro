---
import Dot from '~icons/lucide/dot'

import EmailCopyLink from '@/components/layout/email-copy-link.astro'

interface Props {
	ariaLabel: string
	copyEmailLabel: string
	emailCopiedLabel: string
	resumeLabel: string
}

const { ariaLabel, copyEmailLabel, emailCopiedLabel, resumeLabel } = Astro.props as Props
const EMAIL = 'i@xat.sh'

const LINKS = [
	{ href: 'https://github.com/withxat', label: 'GitHub' },
	{ href: 'https://x.com/withxat', label: 'Twitter' },
	{ href: 'https://t.me/withxat', label: 'Telegram' },
	{ href: `mailto:${EMAIL}`, label: 'Email' },
	{ href: '/resume', label: resumeLabel },
]
---

{/* On a phone-width column the dots sit closer, so the row still fits with the Email copy button touch screens always show. */}
<nav
	class="
		flex flex-wrap items-center gap-2 font-ui text-sm
		@max-lg/page:gap-x-1
	"
	aria-label={ariaLabel}
>
	{LINKS.map((item, index) => {
		const external = item.href.startsWith('https:')
		return (
			<>
				{index > 0 && (
					<Dot aria-hidden="true" class="size-3 shrink-0 text-muted-foreground opacity-70" />
				)}
				{item.href.startsWith('mailto:')
					? (
							<EmailCopyLink
								address={EMAIL}
								copiedLabel={emailCopiedLabel}
								copyLabel={copyEmailLabel}
								label={item.label}
							/>
						)
					: (
							<a
								class="text-link"
								data-astro-prefetch={item.href.startsWith('/') ? '' : undefined}
								href={item.href}
								rel={external ? 'noreferrer' : undefined}
								target={external ? '_blank' : undefined}
							>
								{item.label}
							</a>
						)}
			</>
		)
	})}
</nav>
