---
import type { Locale } from '@/lib/i18n/constants'
import type { Messages } from '@/lib/i18n/messages'

import LocaleSwitcher from '@/components/layout/locale-switcher.astro'
import TextLink from '@/components/layout/text-link.astro'
import ThemeSwitcher from '@/components/layout/theme-switcher.astro'

interface Props {
	locale: Locale
	messages: Pick<Messages, 'header' | 'localeSwitcher'>
	showBack?: boolean
}

const { locale, messages, showBack = false } = Astro.props as Props
---

<header class="space-y-4">
	<div class="flex items-baseline justify-between gap-4">
		{showBack ? <TextLink href="/">{messages.header.goHome}</TextLink> : <div />}
		<LocaleSwitcher aria-label={messages.localeSwitcher.ariaLabel} currentLocale={locale} />
	</div>
	<div class="flex justify-end">
		<ThemeSwitcher labels={messages.header.theme} />
	</div>
</header>
