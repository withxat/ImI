---
import Monitor from '~icons/lucide/monitor'
import Moon from '~icons/lucide/moon'
import Smartphone from '~icons/lucide/smartphone'
import Sun from '~icons/lucide/sun'
import Tablet from '~icons/lucide/tablet'

import {
	DropdownMenu,
	DropdownMenuContent,
	DropdownMenuRadioGroup,
	DropdownMenuRadioItem,
	DropdownMenuTrigger,
} from '@/components/ui/dropdown-menu'

interface Props {
	labels: {
		ariaLabel: string
		dark: string
		light: string
		system: string
	}
}

const { labels } = Astro.props as Props
---

<DropdownMenu class="relative" data-theme-switcher>
	<DropdownMenuTrigger
		aria-label={labels.ariaLabel}
		class="size-8 rounded-md text-muted-foreground"
		size="icon-sm"
		type="button"
		variant="ghost"
		data-theme-toggle
	>
		<span class="size-4" data-theme-current>
			<span data-icon="light" hidden>
				<Sun class="size-full scale-115" />
			</span>
			<span data-icon="dark" hidden>
				<Moon class="size-full" />
			</span>
			<span data-icon="system">
				<Smartphone class="
					size-full
					md:hidden
				"
				/>
				<Tablet class="
					hidden size-full
					md:block
					lg:hidden
				"
				/>
				<Monitor class="
					hidden size-full
					lg:block
				"
				/>
			</span>
		</span>
	</DropdownMenuTrigger>
	<DropdownMenuContent align="end" class="min-w-32">
		<DropdownMenuRadioGroup>
			<DropdownMenuRadioItem
				class="gap-2"
				data-set-theme="system"
				value="system"
			>
				<span class="size-3.5">
					<Smartphone class="
						size-full
						md:hidden
					"
					/>
					<Tablet class="
						hidden size-full
						md:block
						lg:hidden
					"
					/>
					<Monitor class="
						hidden size-full
						lg:block
					"
					/>
				</span>
				<span>{labels.system}</span>
			</DropdownMenuRadioItem>
			<DropdownMenuRadioItem
				class="gap-2"
				data-set-theme="light"
				value="light"
			>
				<Sun class="size-3.5 scale-115" />
				<span>{labels.light}</span>
			</DropdownMenuRadioItem>
			<DropdownMenuRadioItem
				class="gap-2"
				data-set-theme="dark"
				value="dark"
			>
				<Moon class="size-3.5" />
				<span>{labels.dark}</span>
			</DropdownMenuRadioItem>
		</DropdownMenuRadioGroup>
	</DropdownMenuContent>
</DropdownMenu>
