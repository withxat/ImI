---
import Monitor from 'kubai-icons/duotone/icons/monitor'
import Moon from 'kubai-icons/duotone/icons/moon'
import Smartphone from 'kubai-icons/duotone/icons/smartphone'
import Sun from 'kubai-icons/duotone/icons/sun'
import Tablet from 'kubai-icons/duotone/icons/tablet'

import KubaiIcon from '@/components/icons/kubai-icon.astro'
import {
	DropdownMenu,
	DropdownMenuContent,
	DropdownMenuRadioGroup,
	DropdownMenuRadioItem,
	DropdownMenuTrigger,
} from '@/components/ui/dropdown-menu'

interface Props {
	labels: {
		ariaLabel: string
		dark: string
		light: string
		system: string
	}
}

const { labels } = Astro.props as Props
---

<DropdownMenu class="relative" data-theme-switcher>
	<DropdownMenuTrigger
		aria-label={labels.ariaLabel}
		class="size-8 rounded-md text-muted-foreground"
		size="icon-sm"
		type="button"
		variant="ghost"
		data-theme-toggle
	>
		<span class="size-4" data-theme-current>
			<span data-icon="light" hidden>
				<KubaiIcon class="size-full" icon={Sun} />
			</span>
			<span data-icon="dark" hidden>
				<KubaiIcon class="size-full" icon={Moon} />
			</span>
			<span data-icon="system">
				<KubaiIcon
					class="
						size-full
						md:hidden
					"
					icon={Smartphone}
				/>
				<KubaiIcon
					class="
						hidden size-full
						md:block
						lg:hidden
					"
					icon={Tablet}
				/>
				<KubaiIcon
					class="
						hidden size-full
						lg:block
					"
					icon={Monitor}
				/>
			</span>
		</span>
	</DropdownMenuTrigger>
	<DropdownMenuContent align="end" class="min-w-32">
		<DropdownMenuRadioGroup>
			<DropdownMenuRadioItem
				class="gap-2"
				data-set-theme="system"
				value="system"
			>
				<span class="size-3.5">
					<KubaiIcon
						class="
							size-full
							md:hidden
						"
						icon={Smartphone}
					/>
					<KubaiIcon
						class="
							hidden size-full
							md:block
							lg:hidden
						"
						icon={Tablet}
					/>
					<KubaiIcon
						class="
							hidden size-full
							lg:block
						"
						icon={Monitor}
					/>
				</span>
				<span>{labels.system}</span>
			</DropdownMenuRadioItem>
			<DropdownMenuRadioItem
				class="gap-2"
				data-set-theme="light"
				value="light"
			>
				<KubaiIcon class="size-3.5" icon={Sun} />
				<span>{labels.light}</span>
			</DropdownMenuRadioItem>
			<DropdownMenuRadioItem
				class="gap-2"
				data-set-theme="dark"
				value="dark"
			>
				<KubaiIcon class="size-3.5" icon={Moon} />
				<span>{labels.dark}</span>
			</DropdownMenuRadioItem>
		</DropdownMenuRadioGroup>
	</DropdownMenuContent>
</DropdownMenu>
