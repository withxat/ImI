---
import type { Locale } from '@/lib/i18n/constants'

import { Image } from 'astro:assets'

import shinyImi from '@/assets/shiny-imi.png'
import Container from '@/components/layout/container.astro'
import FooterNav from '@/components/layout/footer-nav.astro'
import FooterSiteStats from '@/components/layout/footer-site-stats.astro'
import FooterWanderer from '@/components/layout/footer-wanderer.astro'
import { getMessages } from '@/lib/i18n/messages'
import { REPO_URL } from '@/lib/repo'

interface Props {
	locale: Locale
}

const { locale } = Astro.props as Props
const m = getMessages(locale)
const commitSha = import.meta.env.PUBLIC_IMI_COMMIT_SHA

const moeIcp = (await import('@/assets/icons/moe-icp.svg?raw')).default

const isOnDesignPage = Astro.url.pathname === '/design'
---

<footer transition:persist={`site-footer-${locale}`}>
	<Container class="pt-16 pb-8 text-base/7 text-muted-foreground">
		<div class="space-y-3">
			<FooterWanderer copy={m.wanderer} locale={locale} />
			<FooterNav ariaLabel={m.footer.linksAriaLabel} copyEmailLabel={m.footer.copyEmail} emailCopiedLabel={m.footer.emailCopied} resumeLabel={m.resume.title} />
			<div class="mt-16 flex flex-wrap items-center gap-2">
				<span
					class="inline-flex items-center gap-1.5 text-sm text-muted-foreground"
				>
					<Image
						alt=""
						class="size-4 shrink-0"
						densities={[1, 2]}
						height={20}
						src={shinyImi}
						width={20}
					/>
					<a
						class="
							transition-colors
							hover:text-highlight-text
						"
						href={REPO_URL}
						rel="noreferrer"
						target="_blank"
					>
						ImI
					</a>
					{commitSha && commitSha !== 'dev'
						? (
								<a
									class="
										font-mono transition-colors
										hover:text-highlight-text
									"
									href={`${REPO_URL}/commit/${commitSha}`}
									rel="noreferrer"
									target="_blank"
								>
									{commitSha}
								</a>
							)
						: <span class="font-mono">{commitSha}</span>}
				</span>
				<span aria-hidden="true" class="text-xs" hidden={isOnDesignPage} data-design-link>|</span>
				<a
					class="
						group inline-flex items-center gap-1.5 text-sm text-muted-foreground transition-colors
						hover:text-highlight-text
					"
					hidden={isOnDesignPage}
					href="/design"
					data-design-link
				>
					{m.design.eyebrow}
				</a>
			</div>
			<a
				class="
					flex w-fit items-center gap-1.5 text-sm text-muted-foreground
					hover:text-highlight-text
				"
				href="https://icp.gov.moe/?keyword=20264698"
				rel="noreferrer"
				target="_blank"
			>
				<span
					class="
						size-4 text-primary
						[&_svg]:size-full
					"
					aria-hidden="true"
					set:html={moeIcp}
				/>
				{m.footer.moeIcp}
			</a>
			<FooterSiteStats locale={locale} />
		</div>
	</Container>
</footer>

<script>
import { onAstroPageLoad } from '@/client/astro-page-lifecycle'

onAstroPageLoad(() => {
	const isOnDesign = window.location.pathname === '/design'
	document.querySelectorAll<HTMLElement>('[data-design-link]').forEach((el) => {
		el.hidden = isOnDesign
	})
})
</script>
