---
import Copy from 'kubai-icons/duotone/icons/copy'

import KubaiIcon from '@/components/icons/kubai-icon.astro'

interface Props {
	address: string
	copiedLabel: string
	copyLabel: string
	label?: string
}

const { address, copiedLabel, copyLabel, label = address } = Astro.props as Props
---

<span class="email-copy flex items-center" data-email-copy={address}>
	<a class="text-link" href={`mailto:${address}`}>
		{label}
	</a>
	<span
		class="
			email-copy-slot
			print:hidden
		"
		data-email-copy-slot
	>
		<button aria-label={copyLabel} class="email-copy-button" type="button" data-email-copy-button>
			<KubaiIcon class="size-3.5" icon={Copy} />
		</button>
		<span
			aria-live="polite"
			class="bubble bubble-top"
			data-copied-label={copiedLabel}
			role="status"
			data-email-copy-bubble
		>
		</span>
	</span>
</span>
