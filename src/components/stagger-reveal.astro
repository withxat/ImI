---
interface Props {
	blur?: number
	class?: string
	delayChildren?: number
	itemClass?: string
	staggerChildren?: number
}

const {
	blur = 10,
	class: className,
	delayChildren = 0.06,
	itemClass,
	staggerChildren = 0.052,
} = Astro.props as Props
---

<div
	class={className}
	data-stagger-blur={blur}
	data-stagger-delay={delayChildren}
	data-stagger-item-class={itemClass ?? ''}
	data-stagger-step={staggerChildren}
	data-stagger-reveal
>
	<slot />
</div>

<script>
import { cn as joinClassNames } from '@/lib/cn'

const TOP_SCROLL_PX = 16

for (const root of document.querySelectorAll<HTMLElement>('[data-stagger-reveal]')) {
	if (root.dataset.staggerInitialized === '1')
		continue
	root.dataset.staggerInitialized = '1'

	const blur = Number(root.dataset.staggerBlur ?? 10)
	const baseDelay = Number(root.dataset.staggerDelay ?? 0.06)
	const step = Number(root.dataset.staggerStep ?? 0.052)
	const itemClass = root.dataset.staggerItemClass ?? ''

	const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches
	const atTop = window.scrollY <= TOP_SCROLL_PX
	const vh = window.visualViewport?.height ?? window.innerHeight
	const pad = 48

	const children = [...root.children] as HTMLElement[]

	children.forEach((child, index) => {
		child.className = joinClassNames(child.className, itemClass)
		child.style.transitionProperty = 'opacity, filter'
		child.style.transitionTimingFunction = 'cubic-bezier(0.22, 1, 0.36, 1)'

		const r = child.getBoundingClientRect()
		const intersects = r.top < vh + pad && r.bottom > -pad
		const aboveViewport = r.bottom < 8

		const reveal = (delaySec: number, instant: boolean) => {
			child.style.transitionDuration = instant ? '0ms' : '420ms'
			child.style.transitionDelay = delaySec ? `${delaySec}s` : ''
			child.style.filter = 'blur(0px)'
			child.style.opacity = '1'
		}

		if (reduceMotion || (!atTop && (intersects || aboveViewport))) {
			reveal(0, true)
			return
		}

		child.style.opacity = '0'
		child.style.filter = `blur(${blur}px)`

		if (atTop && intersects) {
			const delay = baseDelay + index * step
			requestAnimationFrame(() => reveal(delay, false))
			return
		}

		const io = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (!entry.isIntersecting)
						continue
					reveal(0, false)
					io.disconnect()
				}
			},
			{ rootMargin: '0px 0px -10% 0px', threshold: 0.14 },
		)
		io.observe(child)
	})
}
</script>
