---
import type { Messages } from '@/lib/i18n/messages'

import { cn } from '@/lib/cn'

interface Props {
	class?: string
	lightbox?: Messages['blog']['lightbox']
	linkCopiedLabel?: string
	reveal?: boolean
}

const { class: className, lightbox, linkCopiedLabel, reveal = true } = Astro.props as Props

const dataAttrs = {
	'data-lightbox-close': lightbox?.close,
	'data-lightbox-next': lightbox?.next,
	'data-lightbox-prev': lightbox?.prev,
	'data-lightbox-zoom': lightbox?.zoom,
	'data-link-copied': linkCopiedLabel,
}
---

{reveal
	? (
			<div class={cn('article-body', className)} data-article-pending="" data-article-reveal {...dataAttrs}>
				<slot />
			</div>
		)
	: (
			<div class={cn('article-body', className)} data-article-plain {...dataAttrs}>
				<slot />
			</div>
		)}
