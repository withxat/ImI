---
/**
 * Site-wide UI stack (all locales): Hanken Grotesk + MiSans.
 *
 * MiSans static instances are generated from MiSans VF and mapped to
 * Latin-facing weights through `cjk-font-polish` so mixed Hanken+MiSans lines stay balanced:
 * 400 -> wght 330, 500 -> wght 415, 600 -> wght 500.
 *
 * The import below is required for side-effects (it triggers vite-plugin-font's
 * subset emission); we use its generated fallback stack after the MiSans family.
 */
import { fontFamilyFallback } from '@/assets/fonts/mi-sans-wght-330.ttf?subsets'
import { css as sourceHanSerifCss } from '@/assets/fonts/source-han-serif-sc-vf.ttf?subsets&key=serif'
import { CJK_FONT_FAMILY } from '@/lib/fonts/cjk-font-polish'

import '@/assets/fonts/mi-sans-wght-415.ttf?subsets'
import '@/assets/fonts/mi-sans-wght-500.ttf?subsets'

const stack = `"Hanken Grotesk", "Hanken Grotesk Fallback", "${CJK_FONT_FAMILY}", ${fontFamilyFallback}`
const serifStack = [
	`"${sourceHanSerifCss.family}"`,
	'"New York"',
	'"Iowan Old Style"',
	'"Apple Garamond"',
	'Baskerville',
	'"Times New Roman"',
	'"Droid Serif"',
	'Times',
	'"Source Serif 4"',
	'Georgia',
	'"Noto Serif SC"',
	'"Songti SC"',
	'"STSong"',
	'"Noto Serif CJK SC"',
	'"Noto Serif CJK TC"',
	'"Source Han Serif SC"',
	'"Source Han Serif TC"',
	'SimSun',
	'NSimSun',
	'FangSong',
	'"KaiTi"',
	'"STKaiti"',
	'"Hiragino Mincho ProN"',
	'"Hiragino Mincho Pro"',
	'"Yu Mincho"',
	'YuMincho',
	'"MS PMincho"',
	'"MS Mincho"',
	'ui-serif',
	'serif',
].join(', ')
const rootFontCss = `:root:root {
  --font-display: ${stack};
  --font-text: ${stack};
  --font-ui: ${stack};
  --font-serif: ${serifStack};
}`
---

<style set:html={rootFontCss} is:global />
