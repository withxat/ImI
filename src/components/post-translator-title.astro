---
import type { Translator, TranslatorBrand } from '@/types/translator'

import claudeLogo from '@/assets/claude.svg?raw'
import geminiLogo from '@/assets/gemini.svg?raw'
import openAiLogo from '@/assets/openai.svg?raw'
import qwenLogo from '@/assets/qwen.svg?raw'
import { Avatar, AvatarFallback } from '@/components/ui/avatar'

interface Props {
	translator: Translator
}

const { translator } = Astro.props as Props
const [brand, model] = translator

const TRANSLATOR_META: Record<TranslatorBrand, { label: string, logo: string }> = {
	claude: { label: 'Claude', logo: claudeLogo },
	gemini: { label: 'Gemini', logo: geminiLogo },
	openai: { label: 'OpenAI', logo: openAiLogo },
	qwen: { label: 'Qwen', logo: qwenLogo },
}

const meta = TRANSLATOR_META[brand]
---

<div class="mb-1.5 flex items-center gap-2 font-ui text-sm font-medium text-foreground">
	<Avatar class="size-5">
		<AvatarFallback class="bg-background text-foreground shadow-xs ring-1 ring-border/80">
			<span
				class="
					inline-flex size-3.5 text-foreground
					[&_svg]:size-full [&_svg]:fill-current
				"
				aria-hidden="true"
				set:html={meta.logo}
			/>
		</AvatarFallback>
	</Avatar>
	<span>{model}</span>
</div>
