---
import type { ImageMetadata } from 'astro'

import type { Translator, TranslatorBrand } from '@/types/translator'

import claudeLogo from '@/assets/claude.svg'
import geminiLogo from '@/assets/gemini.svg'
import openAiLogo from '@/assets/openai.svg'
import qwenLogo from '@/assets/qwen.svg'
import { cn } from '@/lib/cn'

interface Props {
	translator: Translator
}

const { translator } = Astro.props as Props
const [brand, model] = translator

const TRANSLATOR_META: Record<TranslatorBrand, { label: string, logo: ImageMetadata, logoClassName?: string }> = {
	claude: { label: 'Claude', logo: claudeLogo },
	gemini: { label: 'Gemini', logo: geminiLogo },
	openai: { label: 'OpenAI', logo: openAiLogo, logoClassName: 'dark:invert' },
	qwen: { label: 'Qwen', logo: qwenLogo },
}

const meta = TRANSLATOR_META[brand]
---

<div class="mb-1.5 flex items-center gap-2 font-ui text-sm font-medium text-foreground">
	<span class="flex size-5 items-center justify-center rounded-full bg-background text-foreground shadow-xs ring-1 ring-border/80">
		<img alt={meta.label} class={cn('size-3.5', meta.logoClassName)} src={meta.logo.src} />
	</span>
	<span>{model}</span>
</div>
