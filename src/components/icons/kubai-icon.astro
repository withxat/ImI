---
import type { KubaiIconData } from 'kubai-icons'

import { toSvg } from 'kubai-icons'

interface Props {
	attrs?: Record<string, number | string>
	class?: string
	icon: KubaiIconData
	title?: string
}

const { attrs, class: className, icon, title } = Astro.props as Props
const svg = toSvg(icon, {
	attrs,
	className,
	size: '1em',
	title,
})
---

<Fragment set:html={svg} />
