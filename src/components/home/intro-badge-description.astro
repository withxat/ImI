---
import type { Locale } from '@/lib/i18n/constants'
import type { IntroBadgeKind } from '@/lib/i18n/intro-badges'

interface Props {
	kind: IntroBadgeKind
	locale: Locale
}

const { kind, locale } = Astro.props as Props

const CCNU_URL = 'https://en.wikipedia.org/wiki/Central_China_Normal_University'
---

{locale === 'en' && kind === 'products' && (
	<>I work on education AI products at <a class="text-link" href={CCNU_URL} rel="noreferrer" target="_blank">Central China Normal University</a>, mostly on the frontend, interaction, and supporting tools.</>
)}
{locale === 'en' && kind === 'systems' && (
	<>I studied <i>Intelligent Transportation Systems</i>, learning how hardware, rules, and software fit together.</>
)}
{locale === 'zh' && kind === 'products' && (
	<>目前在 <a class="text-link" href={CCNU_URL} rel="noreferrer" target="_blank">华中师范大学</a> 团队做面向教学场景的 AI 产品，平时主要写前端、交互和配套工具。</>
)}
{locale === 'zh' && kind === 'systems' && (
	<>本科念的是 <i>智能交通系统</i>，学的就是硬件、规则和软件怎么咬合在一起。</>
)}
{locale === 'ja' && kind === 'products' && (
	<>今は <a class="text-link" href={CCNU_URL} rel="noreferrer" target="_blank">華中師範大学</a> のチームで教育向けの AI プロダクトを作っていて、主にフロントエンドや UI、周辺のツールを担当しています。</>
)}
{locale === 'ja' && kind === 'systems' && (
	<>大学では <i>高度交通システム</i> を専攻し、インフラやルール、ソフトウェアがどう噛み合うかを学びました。</>
)}
