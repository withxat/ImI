---
import type { Locale } from '@/lib/i18n/constants'
import type { IntroBadgeKind } from '@/lib/i18n/intro-badges'

interface Props {
	kind: IntroBadgeKind
	locale: Locale
}

const { kind, locale } = Astro.props as Props

const CCNU_URL = 'https://en.wikipedia.org/wiki/Central_China_Normal_University'
---

{locale === 'en' && kind === 'products' && (
	<>Today I work at <a class="text-link" href={CCNU_URL} rel="noreferrer" target="_blank">Central China Normal University</a> on production AI products and intelligent experiences—exploring how models reshape interfaces, collaboration, and tools.</>
)}
{locale === 'en' && kind === 'systems' && (
	<>My background is in <i>Intelligent Transportation Systems</i>: software and design where physical infrastructure meets digital systems.</>
)}
{locale === 'zh' && kind === 'products' && (
	<>目前在 <a class="text-link" href={CCNU_URL} rel="noreferrer" target="_blank">华中师范大学</a> 参与生产级 AI 产品与智能体验，探索模型如何重塑界面、协作与工具。</>
)}
{locale === 'zh' && kind === 'systems' && (
	<>我的专业背景是 <i>智能交通系统</i>：让实体基础设施与数字系统相遇的软件与设计。</>
)}
{locale === 'ja' && kind === 'products' && (
	<>現在は <a class="text-link" href={CCNU_URL} rel="noreferrer" target="_blank">華中師範大学</a> で本番向け AI プロダクトとインテリジェント体験に取り組み、モデルがインターフェース・協業・ツールをどう変えるかを探っています。</>
)}
{locale === 'ja' && kind === 'systems' && (
	<>背景は <i>インテリジェント交通システム</i>。物理インフラとデジタルが交差するソフトウェアとデザインです。</>
)}
