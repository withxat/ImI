---
import type { Locale } from '@/lib/i18n/constants'
import type { IntroBadgeKind } from '@/lib/i18n/intro-badges'

interface Props {
	kind: IntroBadgeKind
	locale: Locale
}

const { kind, locale } = Astro.props as Props

const CCNU_URL = 'https://en.wikipedia.org/wiki/Central_China_Normal_University'
---

{locale === 'en' && kind === 'products' && (
	<>I currently work at <a class="text-link" href={CCNU_URL} rel="noreferrer" target="_blank">Central China Normal University</a>, building production AI products and exploring how models change interfaces and tools.</>
)}
{locale === 'en' && kind === 'systems' && (
	<>I studied <i>Intelligent Transportation Systems</i>, where physical infrastructure meets software.</>
)}
{locale === 'zh' && kind === 'products' && (
	<>目前在 <a class="text-link" href={CCNU_URL} rel="noreferrer" target="_blank">华中师范大学</a> 做生产级 AI 产品，探索模型如何改变界面和工作流。</>
)}
{locale === 'zh' && kind === 'systems' && (
	<>本科专业是 <i>智能交通系统</i>，关注实体基础设施与软件交汇的地方。</>
)}
{locale === 'ja' && kind === 'products' && (
	<>現在は <a class="text-link" href={CCNU_URL} rel="noreferrer" target="_blank">華中師範大学</a> で本番向け AI プロダクトを作りながら、モデルが UI やツールをどう変えるかを探っています。</>
)}
{locale === 'ja' && kind === 'systems' && (
	<>専攻は <i>高度交通システム</i>。物理インフラとソフトウェアが交わる領域で設計・開発をしてきました。</>
)}
