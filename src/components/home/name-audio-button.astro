---
// Audio playback button with animated volume waves. Click reveals the IPA pronunciation
// and plays /xat.mp3. Client behavior lives in src/client/name-audio.ts.

import { Button } from '@/components/ui/button'

const SPEAKER_PATH
	= 'M11 4.702a.705.705 0 0 0-1.203-.498L6.413 7.587A1.4 1.4 0 0 1 5.416 8H3a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h2.416a1.4 1.4 0 0 1 .997.413l3.383 3.384A.705.705 0 0 0 11 19.298z'
const WAVE_MID = 'M16 9a5 5 0 0 1 0 6'
const WAVE_OUTER = 'M19.364 18.364a9 9 0 0 0 0-12.728'
---

<span class="group/name-audio inline-flex items-baseline gap-0.75" data-name-audio-state="idle" data-name-audio-root>
	<span
		class="
			inline-grid -translate-y-0.75 grid-cols-[0fr] font-mono text-sm whitespace-nowrap text-highlight-strong opacity-0 transition-[grid-template-columns,opacity] duration-300
			ease-out
			group-data-[name-audio-state=open]/name-audio:grid-cols-[1fr] group-data-[name-audio-state=open]/name-audio:opacity-100
			motion-reduce:transition-none
			sm:text-base
		"
		data-name-ipa
	>
		<span class="min-w-0 overflow-hidden">/ˈeɪtoʊ/</span>
	</span>
	<Button
		class="
			size-7 shrink-0 rounded-md text-foreground
			focus-visible:ring-ring focus-visible:ring-offset-1 focus-visible:ring-offset-background
			sm:size-6
		"
		aria-label="Play name pronunciation"
		size="icon-sm"
		type="button"
		variant="ghost"
		data-name-play
	>
		<svg
			aria-hidden="true"
			class="size-3.5 shrink-0"
			fill="none"
			height="18"
			stroke="currentColor"
			stroke-linecap="round"
			stroke-linejoin="round"
			stroke-width="2"
			viewBox="0 0 24 24"
			width="18"
			xmlns="http://www.w3.org/2000/svg"
			data-name-volume-icon
		>
			<path d={SPEAKER_PATH} />
			<path d={WAVE_MID} data-wave="mid" />
			<path d={WAVE_OUTER} data-wave="outer" />
		</svg>
	</Button>
	<audio preload="none" src="/xat.mp3" data-name-audio hidden></audio>
</span>
