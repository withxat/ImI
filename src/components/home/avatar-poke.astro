---
// The home avatar. A poke squishes it and it answers in a small bubble; poke it past
// its lines and it unlocks a retro RPG dialog pointing to /resume (src/client/avatar-poke.ts).
import type { Messages } from '@/lib/i18n/messages'

import { Image } from 'astro:assets'

import { Avatar, AvatarFallback, AvatarImage } from '@/components/ui/avatar'
import { PROFILE_AVATAR_SRC } from '@/lib/seo-data'

interface Props {
	copy: Messages['home']['poke']
}

const { copy } = Astro.props as Props
---

<div
	class="avatar-poke relative w-fit"
	data-lines={JSON.stringify(copy.lines)}
	data-secret-line={copy.secret.line}
	data-avatar-poke
>
	<div class="avatar-poke-body">
		<Avatar class="
			size-14 rounded-xl border border-border
			after:rounded-xl
			sm:size-16
		"
		>
			<AvatarImage class="rounded-xl">
				<Image
					alt="Xat"
					class="size-full object-cover"
					fetchpriority="high"
					height={128}
					loading="eager"
					referrerpolicy="no-referrer"
					src={PROFILE_AVATAR_SRC}
					width={128}
				/>
			</AvatarImage>
			<AvatarFallback class="rounded-xl">X</AvatarFallback>
		</Avatar>
	</div>
	<button
		aria-label={copy.label}
		class="absolute inset-0 z-2 cursor-pointer touch-manipulation rounded-xl"
		type="button"
		data-avatar-poke-button
	>
	</button>
	<span aria-live="polite" class="bubble bubble-right" role="status" data-avatar-poke-bubble></span>
	<div
		aria-label={copy.secret.badge}
		class="avatar-poke-rpg"
		role="dialog"
		data-avatar-poke-secret
		hidden
	>
		{/* Stepped pixel-art pointers (left on desktop, up on mobile) */}
		<svg
			aria-hidden="true"
			class="avatar-poke-rpg-tail avatar-poke-rpg-tail-left"
			height="14"
			shape-rendering="crispEdges"
			viewBox="0 0 5 7"
			width="10"
		>
			<path d="M3 0h1v1H3zM2 1h1v1H2zM1 2h1v1H1zM0 3h1v1H0zM1 4h1v1H1zM2 5h1v1H2zM3 6h1v1H3z" fill="var(--foreground)" />
			<path d="M3 1h2v5H3zM2 2h1v3H2zM1 3h1v1H1z" fill="var(--popover)" />
		</svg>
		<svg
			aria-hidden="true"
			class="avatar-poke-rpg-tail avatar-poke-rpg-tail-up"
			height="10"
			shape-rendering="crispEdges"
			viewBox="0 0 7 5"
			width="14"
		>
			<path d="M3 0h1v1H3zM2 1h1v1H2zM4 1h1v1H4zM1 2h1v1H1zM5 2h1v1H5zM0 3h1v1H0zM6 3h1v1H6z" fill="var(--foreground)" />
			<path d="M1 3h5v2H1zM2 2h3v1H2zM3 1h1v1H3z" fill="var(--popover)" />
		</svg>
		<div class="avatar-poke-rpg-head">
			<span class="avatar-poke-rpg-badge">
				<svg
					aria-hidden="true"
					class="avatar-poke-rpg-star"
					height="10"
					shape-rendering="crispEdges"
					viewBox="0 0 7 7"
					width="10"
				>
					<path d="M3 0h1v2H3zM0 2h7v1H0zM1 3h5v1H1zM2 4h3v1H2zM1 5h2v1H1zM4 5h2v1H4zM1 6h1v1H1zM5 6h1v1H5z" fill="currentColor" />
				</svg>
				<span>{copy.secret.badge}</span>
			</span>
			<span aria-hidden="true" class="avatar-poke-rpg-count tabular-nums">×{copy.lines.length + 1}</span>
		</div>
		<div class="avatar-poke-rpg-copy">
			<span aria-hidden="true" class="invisible select-none">{copy.secret.line}</span>
			<span aria-live="polite" class="avatar-poke-rpg-typed" data-avatar-poke-secret-text></span>
		</div>
		<div aria-hidden="true" class="avatar-poke-rpg-divider"></div>
		<div class="avatar-poke-rpg-actions">
			<a class="avatar-poke-rpg-cta" href="/resume" data-astro-prefetch>
				<svg
					aria-hidden="true"
					class="avatar-poke-rpg-cursor"
					height="10"
					shape-rendering="crispEdges"
					viewBox="0 0 4 7"
					width="6"
				>
					<path d="M0 0h1v7H0zM1 1h1v5H1zM2 2h1v3H2zM3 3h1v1H3z" fill="currentColor" />
				</svg>
				<span>{copy.secret.cta}</span>
			</a>
			<button class="avatar-poke-rpg-close" type="button" data-avatar-poke-close>
				{copy.secret.close}
			</button>
		</div>
	</div>
</div>
