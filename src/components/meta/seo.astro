---
import type { Locale } from '@/lib/i18n/constants'

import { htmlLangFor, LOCALES, ogLocaleFor } from '@/lib/i18n/constants'
import { OG_HEIGHT, OG_WIDTH } from '@/lib/og/constants'
import {
	absoluteUrl,
	DEFAULT_DESCRIPTION,
	DEFAULT_OG_IMAGE,
	escapeJsonForHtml,
	SITE_NAME,
	TWITTER_SITE,
} from '@/lib/seo-data'

interface Props {
	canonicalPath: string
	description?: string
	image?: string
	imageAlt?: string
	jsonLd?: unknown | unknown[]
	locale: Locale
	title: string
	type?: 'article' | 'profile' | 'website'
}

const {
	canonicalPath,
	description = DEFAULT_DESCRIPTION,
	image = DEFAULT_OG_IMAGE,
	imageAlt,
	jsonLd,
	locale,
	title,
	type = 'website',
} = Astro.props as Props

const canonicalUrl = absoluteUrl(canonicalPath)
const jsonLdItems = Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : []
const contentLanguage = htmlLangFor(locale)
const primaryOgLocale = ogLocaleFor(locale)
const otherLocales = LOCALES.filter(l => l !== locale)
const resolvedImageAlt = imageAlt ?? `${title} Open Graph image`
---

<title>{title}</title>
<meta content={description} name="description" />
<meta content={contentLanguage} http-equiv="content-language" />
<link href={canonicalUrl} rel="canonical" />
<meta content={SITE_NAME} property="og:site_name" />
<meta content={type} property="og:type" />
<meta content={title} property="og:title" />
<meta content={description} property="og:description" />
<meta content={canonicalUrl} property="og:url" />
<meta content={image} property="og:image" />
<meta content={String(OG_WIDTH)} property="og:image:width" />
<meta content={String(OG_HEIGHT)} property="og:image:height" />
<meta content={resolvedImageAlt} property="og:image:alt" />
<meta content={primaryOgLocale} property="og:locale" />
{otherLocales.map(l => (
	<meta content={ogLocaleFor(l)} property="og:locale:alternate" />
))}
<meta content="summary_large_image" name="twitter:card" />
<meta content={TWITTER_SITE} name="twitter:site" />
<meta content={TWITTER_SITE} name="twitter:creator" />
<meta content={title} name="twitter:title" />
<meta content={description} name="twitter:description" />
<meta content={image} name="twitter:image" />
<meta content={resolvedImageAlt} name="twitter:image:alt" />
{jsonLdItems.map(item => (
	<script set:html={escapeJsonForHtml(item)} type="application/ld+json" is:inline />
))}
<slot />
