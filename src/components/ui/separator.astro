---
import { cn } from '@/lib/cn'

interface Props {
	class?: string
	orientation?: 'horizontal' | 'vertical'
}

const { class: className, orientation = 'horizontal' } = Astro.props as Props
const base = `shrink-0 bg-border data-[orientation=horizontal]:h-px data-[orientation=horizontal]:w-full data-[orientation=vertical]:w-px data-[orientation=vertical]:self-stretch`
---

<div
	aria-orientation={orientation}
	class={cn(base, className)}
	data-orientation={orientation}
	data-slot="separator"
	role="separator"
></div>
