---
import type { HTMLTag, Polymorphic } from 'astro/types'

import { cn } from '@/lib/cn'

type Props<Tag extends HTMLTag = 'p'> = Polymorphic<{ as: Tag }>

const { as: Tag = 'p', class: className, ...rest } = Astro.props as Props
---

<Tag class={cn('font-ui text-base font-medium text-foreground', className)} {...rest}>
	<slot />
</Tag>
