---
import type { HTMLAttributes } from "astro/types";

import { cn } from "@/lib/utils";

type CardOverlayVariant = "default" | "glass";

interface Props extends HTMLAttributes<"div"> {
  class?: string
  variant?: CardOverlayVariant
}

const {
  class: className = "",
  variant = "default",
  ...rest
} = Astro.props as Props;
---

<div
	{...rest}
	class={cn("", `
		absolute inset-0 z-10 p-6 opacity-0 transition-opacity duration-300 ease-out
		group-hover/card:opacity-100
	`, variant === "glass"
      ? "bg-primary/70 text-primary-foreground backdrop-blur-sm"
      : "bg-primary text-primary-foreground", className)}
	data-slot="card-overlay"
>
  <slot />
</div>
