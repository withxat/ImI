---
import type { HTMLAttributes } from "astro/types";

import { cn } from "@/lib/utils";

interface Props extends HTMLAttributes<"thead"> {
  class?: string
}

const {
  class: className = "",
  ...rest
} = Astro.props as Props;
---

<thead class={cn("[&_tr]:border-b", className)} data-slot="table-header" {...rest}>
  <slot />
</thead>
