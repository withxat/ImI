---
import type { HTMLAttributes } from "astro/types";

import { cn } from "@/lib/utils";

interface Props extends HTMLAttributes<"tbody"> {
  class?: string
}

const {
  class: className = "",
  ...rest
} = Astro.props as Props;
---

<tbody class={cn("[&_tr:last-child]:border-0", "[&_tr:last-child]:border-0", className)} data-slot="table-body" {...rest}>
  <slot />
</tbody>
