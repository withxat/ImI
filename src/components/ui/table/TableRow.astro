---
import type { HTMLAttributes } from "astro/types";

import { cn } from "@/lib/utils";

interface Props extends HTMLAttributes<"tr"> {
  class?: string
}

const {
  class: className = "",
  ...rest
} = Astro.props as Props;
---

<tr
	class={cn(`
		border-b transition-colors
		hover:bg-muted/50
		data-[state=selected]:bg-muted
	`, className)}
	data-slot="table-row"
	{...rest}
>
  <slot />
</tr>
