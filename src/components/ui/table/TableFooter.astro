---
import type { HTMLAttributes } from "astro/types";

import { cn } from "@/lib/utils";

interface Props extends HTMLAttributes<"tfoot"> {
  class?: string
}

const {
  class: className = "",
  ...rest
} = Astro.props as Props;
---

<tfoot
	class={cn(`
		border-t bg-muted/50 font-medium
		[&>tr]:last:border-b-0
	`, className)}
	data-slot="table-footer"
	{...rest}
>
  <slot />
</tfoot>
