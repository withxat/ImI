---
import type { HTMLAttributes } from 'astro/types'

import { cn } from '@/lib/utils'

interface Props extends HTMLAttributes<'button'> {
	class?: string
}

const { class: className = '', ...rest } = Astro.props as Props;
---

<button
	{...rest}
	class={cn('', className)}
	data-slot="popover-close"
>
	<slot />
</button>
