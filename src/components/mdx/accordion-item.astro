---
// Each <details> stores its open state in markup, so we can use it directly with
// no client JS. The shared CSS lives in globals + a small inline style here.

interface Props {
	class?: string
	defaultOpen?: boolean
	value?: string
}

const { class: className, defaultOpen = false, value } = Astro.props as Props
---

<details class:list={['accordion-item group', className]} data-slot="accordion-item" data-value={value} open={defaultOpen}>
	<slot />
</details>

<style>
	.accordion-item :global([data-slot='accordion-trigger']) {
		display: flex;
		flex: 1;
		cursor: pointer;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1rem;
		border-radius: 0.375rem;
		padding-block: 0;
		text-align: left;
		font-size: 1rem;
		font-weight: 400;
		color: var(--color-muted-foreground);
		line-height: 1.625;
	}
	.accordion-item[open] :global([data-slot='accordion-indicator']) {
		transform: translateY(0.125rem) rotate(180deg);
	}
</style>
