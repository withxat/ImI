---
import { cn } from '@/lib/cn'

const { class: className, ...rest } = Astro.props as { [k: string]: unknown, class?: string }
---

<blockquote class={cn('relative my-8 ps-4 italic', className)} {...rest}>
	<span aria-hidden="true" class="absolute inset-y-0 left-0 w-[3px] rounded-full bg-muted-foreground/45"></span>
	<slot />
</blockquote>
