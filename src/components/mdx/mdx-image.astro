---
import { cn } from '@/lib/cn'

interface Props {
	[key: string]: unknown
	'alt'?: string
	'class'?: string
	'data-blurhash-bg'?: string
	'height'?: number | string
	'placeholder'?: string
	'src': string
	'width'?: number | string
}

const CLOUDFLARE_IMAGE_DOMAIN = 'assets.xat.sh'
const ARTICLE_IMAGE_WIDTH = 720
const ARTICLE_IMAGE_SIZES = '(min-width: 768px) 624px, calc(100vw - 32px)'

const {
	alt = '',
	class: className,
	height,
	placeholder,
	src,
	width,
	...rest
} = Astro.props as Props

function toPos(n: unknown): number | undefined {
	if (typeof n === 'number')
		return Number.isFinite(n) && n > 0 ? n : undefined
	if (typeof n !== 'string')
		return undefined
	const p = Number.parseInt(n, 10)
	return Number.isFinite(p) && p > 0 ? p : undefined
}

function isCloudflare(url: string) {
	try {
		return new URL(url).hostname === CLOUDFLARE_IMAGE_DOMAIN
	}
	catch {
		return false
	}
}

function cloudflareSrc(url: string, w: number) {
	if (!isCloudflare(url))
		return url
	try {
		const u = new URL(url)
		return `https://${u.hostname}/cdn-cgi/image/width=${w},format=auto${u.pathname}`
	}
	catch {
		return url
	}
}

const w = toPos(width)
const h = toPos(height)

let resolvedSrc = src
let resolvedW = w
let resolvedH = h
let srcset: string | undefined
let sizes: string | undefined

if (w && h) {
	const aspect = w / h
	const displayW = Math.min(ARTICLE_IMAGE_WIDTH, Math.max(w, 1))
	const displayH = Math.round(displayW / aspect)
	resolvedW = displayW
	resolvedH = displayH

	if (isCloudflare(src)) {
		resolvedSrc = cloudflareSrc(src, displayW)
		srcset = [1, 1.5, 2]
			.map(m => `${cloudflareSrc(src, Math.round(displayW * m))} ${m}x`)
			.join(', ')
		sizes = ARTICLE_IMAGE_SIZES
	}
}

const bgStyle = placeholder ? `background-image: url(${placeholder});` : ''
---

<img
	alt={alt}
	class={cn('mdx-image rounded-xl border', className)}
	decoding="async"
	height={resolvedH}
	loading="lazy"
	sizes={sizes}
	src={resolvedSrc}
	srcset={srcset}
	style={bgStyle}
	width={resolvedW}
	data-mdx-img
	{...rest}
/>

<script>
for (const img of document.querySelectorAll<HTMLImageElement>('img[data-mdx-img]')) {
	if (img.dataset.imgInit === '1')
		continue
	img.dataset.imgInit = '1'
	const mark = () => img.setAttribute('data-loaded', '')
	if (img.complete && img.naturalWidth)
		mark()
	else img.addEventListener('load', mark, { once: true })
}
</script>
