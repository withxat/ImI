---
import Braces from '~icons/lucide/braces'
import FileCode2 from '~icons/lucide/file-code-2'
import FileType2 from '~icons/lucide/file-type-2'
import Folder from '~icons/lucide/folder'

import { cn } from '@/lib/cn'

const { class: className, ...rest } = Astro.props as { [k: string]: unknown, class?: string }

function iconFor(lang: unknown): 'braces' | 'fileCode' | 'fileType' | 'folder' | null {
	if (typeof lang !== 'string')
		return null
	switch (lang) {
		case 'json': return 'braces'
		case 'css': return 'fileCode'
		case 'js':
		case 'jsx':
		case 'ts':
		case 'tsx':
		case 'typescript':
			return 'fileType'
		default: return 'folder'
	}
}

const lang = (rest as Record<string, unknown>)['data-language']
const icon = iconFor(lang)
const isPrettyTitle = 'data-rehype-pretty-code-title' in (rest as Record<string, unknown>)
---

{isPrettyTitle
	? (
			<figcaption
				class={cn(
					`
						flex h-9.5 items-center justify-between gap-3 px-4 pe-2 text-[.8125rem] text-white/70
						[&_svg]:size-4.5 [&_svg]:text-white/50
						sm:[&_svg]:size-4
					`,
					className,
				)}
				data-mdx-pretty-caption
				{...rest}
			>
				<span class="flex min-w-0 flex-1 items-center gap-2">
					{icon === 'braces' && <Braces stroke-width={2} />}
					{icon === 'fileCode' && <FileCode2 stroke-width={2} />}
					{icon === 'fileType' && <FileType2 stroke-width={2} />}
					{icon === 'folder' && <Folder stroke-width={2} />}
					<span class="truncate"><slot /></span>
				</span>
				<button
					class="
						relative inline-flex size-7 shrink-0 cursor-pointer items-center justify-center rounded-md text-white/70 transition
						hover:bg-white/10 hover:text-white
					"
					aria-label="Copy code"
					type="button"
					data-copy-trigger
				>
					<svg class="size-3.5" data-copy-icon="copy" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24">
						<rect height="14" rx="2" ry="2" width="14" x="8" y="8"></rect>
						<path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"></path>
					</svg>
					<svg class="hidden size-3.5" data-copy-icon="check" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24">
						<polyline points="20 6 9 17 4 12"></polyline>
					</svg>
				</button>
			</figcaption>
		)
	: (
			<figcaption
				class={cn(
					`
						flex items-center gap-2 text-[.8125rem] text-code-foreground
						[&_svg]:size-4.5 [&_svg]:text-code-foreground [&_svg]:opacity-70
						sm:[&_svg]:size-4
					`,
					className,
				)}
				{...rest}
			>
				{icon === 'braces' && <Braces stroke-width={2} />}
				{icon === 'fileCode' && <FileCode2 stroke-width={2} />}
				{icon === 'fileType' && <FileType2 stroke-width={2} />}
				{icon === 'folder' && <Folder stroke-width={2} />}
				<slot />
			</figcaption>
		)}

<script>
for (const trigger of document.querySelectorAll<HTMLButtonElement>('[data-copy-trigger]')) {
	if (trigger.dataset.copyInit === '1')
		continue
	trigger.dataset.copyInit = '1'

	trigger.addEventListener('click', async () => {
		const caption = trigger.closest('[data-mdx-pretty-caption]')
		const figure = caption?.closest('figure')
		const code = figure?.querySelector('pre code')?.textContent ?? ''
		try {
			await navigator.clipboard.writeText(code)
			const copyIcon = trigger.querySelector<HTMLElement>('[data-copy-icon="copy"]')
			const checkIcon = trigger.querySelector<HTMLElement>('[data-copy-icon="check"]')
			copyIcon?.classList.add('hidden')
			checkIcon?.classList.remove('hidden')
			setTimeout(() => {
				copyIcon?.classList.remove('hidden')
				checkIcon?.classList.add('hidden')
			}, 1600)
		}
		catch {}
	})
}
</script>
