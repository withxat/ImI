---
import { getImage, Image } from 'astro:assets'

import { cn } from '@/lib/cn'

/** Inline article column (~640px); 1280 covers 2× DPR without serving full originals. */
const ARTICLE_IMAGE_WIDTHS = [640, 1280] as const
const ARTICLE_IMAGE_SIZES = '(min-width: 768px) 640px, 100vw'

interface Props {
	alt: string
	class?: string
	decoding?: 'async' | 'sync'
	fetchpriority?: 'auto' | 'high' | 'low'
	height?: number
	loading?: 'eager' | 'lazy'
	sizes?: string
	src: string
	width?: number
}

const {
	alt,
	class: className,
	decoding = 'async',
	fetchpriority = 'auto',
	height,
	loading = 'lazy',
	sizes,
	src,
	width,
	...rest
} = Astro.props as Props

const isRemote = src.startsWith('http://') || src.startsWith('https://')

const remoteFullSize = isRemote
	? await getImage({ inferSize: true, src })
	: null
---

<figure class={cn('my-8', className)}>
	{isRemote
		? (
				<Image
					alt={alt}
					class="rounded-lg"
					data-pswp-fullsrc={src}
					data-pswp-height={remoteFullSize?.attributes.height}
					data-pswp-width={remoteFullSize?.attributes.width}
					decoding={decoding}
					fetchpriority={fetchpriority}
					loading={loading}
					sizes={sizes ?? ARTICLE_IMAGE_SIZES}
					src={src}
					widths={ARTICLE_IMAGE_WIDTHS}
					inferSize
					{...rest}
				/>
			)
		: (
				<Image
					alt={alt}
					class="rounded-lg"
					decoding={decoding}
					fetchpriority={fetchpriority}
					height={height ?? 720}
					loading={loading}
					sizes={sizes ?? ARTICLE_IMAGE_SIZES}
					src={src}
					width={width ?? 1280}
					widths={ARTICLE_IMAGE_WIDTHS}
					{...rest}
				/>
			)}
	{alt && (
		<figcaption class="text-center text-sm text-muted-foreground">
			{alt}
		</figcaption>
	)}
</figure>
