---
import { cn } from '@/lib/cn'

const { class: className, ...rest } = Astro.props as { [k: string]: unknown, class?: string }
const figureClass = 'data-rehype-pretty-code-figure:relative data-rehype-pretty-code-figure:my-6 data-rehype-pretty-code-figure:overflow-hidden data-rehype-pretty-code-figure:rounded-xl data-rehype-pretty-code-figure:bg-code data-rehype-pretty-code-figure:text-sm data-rehype-pretty-code-figure:shadow-sm data-rehype-pretty-code-figure:ring-1 data-rehype-pretty-code-figure:ring-black/10 dark:data-rehype-pretty-code-figure:ring-white/12'
---

<figure class={cn(figureClass, className)} dir="ltr" tabindex={-1} {...rest}><slot /></figure>
