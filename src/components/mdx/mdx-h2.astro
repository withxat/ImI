---
import { cn } from '@/lib/cn'

const { class: className, id, ...rest } = Astro.props as { [k: string]: unknown, class?: string, id?: string }

const baseClasses = 'mt-12 scroll-m-20 font-heading text-2xl font-semibold first:mt-0 lg:mt-16 [&+p]:mt-4! *:[code]:text-2xl'
---

<h2 class={cn(baseClasses, className)} id={id} {...rest}>
	{id ? <a href={`#${id}`}><slot /></a> : <slot />}
</h2>
