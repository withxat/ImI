---
import { cn } from '@/lib/cn'

const { class: className, ...rest } = Astro.props as { [k: string]: unknown, class?: string }
---

<div class="relative" data-mdx-pre-root>
	<div class="pointer-events-none absolute inset-e-0 top-0 z-30 pe-2.5 pt-2.5" data-mdx-pre-copy-slot>
		<div class="pointer-events-auto">
			<button
				class="
					relative inline-flex size-7 shrink-0 cursor-pointer items-center justify-center rounded-md border border-white/12
					bg-white/6 text-white/85 backdrop-blur-[2px] transition
					hover:bg-white/11 hover:text-white
				"
				aria-label="Copy code"
				type="button"
				data-mdx-pre-copy
			>
				<svg class="size-3" data-copy-icon="copy" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24">
					<rect height="14" rx="2" ry="2" width="14" x="8" y="8"></rect>
					<path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"></path>
				</svg>
				<svg class="hidden size-3 text-emerald-300" data-copy-icon="check" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24">
					<polyline points="20 6 9 17 4 12"></polyline>
				</svg>
			</button>
		</div>
	</div>
	<div class="overflow-x-auto py-3.5" style="max-height: 600px;">
		<pre
			class={cn(
				`
					w-max min-w-full px-4 text-[.8125rem] outline-none
					*:flex *:flex-col
					has-data-highlighted-line:px-0
					has-data-line-numbers:px-0
				`,
				className,
			)}
			{...rest}
		><slot /></pre>
	</div>
</div>
