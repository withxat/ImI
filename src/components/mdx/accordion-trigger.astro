---
import ChevronDown from '~icons/lucide/chevron-down'

import { cn } from '@/lib/cn'

interface Props {
	class?: string
}

const { class: className } = Astro.props as Props
---

<summary
	class={cn(
		`
			list-none py-0! text-base! leading-relaxed font-normal! text-muted-foreground
			[&::-webkit-details-marker]:hidden
		`,
		className,
	)}
	data-slot="accordion-trigger"
>
	<span class="flex flex-1 items-start justify-between gap-4">
		<span><slot /></span>
		<ChevronDown
			class="pointer-events-none size-4 shrink-0 translate-y-0.5 opacity-80 transition-transform duration-200 ease-in-out"
			data-slot="accordion-indicator"
		/>
	</span>
</summary>
