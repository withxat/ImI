---
import type { Locale } from '@/lib/i18n/constants'

import HankenUi from '@/components/ui-fonts/hanken-ui.astro'
import MisansUi from '@/components/ui-fonts/misans-ui.astro'
import { localeUsesCjkUiFont } from '@/lib/i18n/locale-switch'

interface Props {
	locale: Locale
}

const { locale } = Astro.props as Props
---

{localeUsesCjkUiFont(locale) ? <MisansUi /> : <HankenUi />}
