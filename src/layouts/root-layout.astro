---
import type { Locale } from '@/lib/i18n/constants'

import { getImage } from 'astro:assets'
import { ClientRouter } from 'astro:transitions'

import shinyImi from '@/assets/shiny-imi.png'
import MisansUi from '@/components/fonts/mi-sans-global-font.astro'
import Footer from '@/components/layout/footer.astro'
import { htmlLangFor } from '@/lib/i18n/constants'
import { getMessages } from '@/lib/i18n/messages'
import { RSS_FEED_URL, RSS_FEED_URL_EN, RSS_FEED_URL_JA } from '@/lib/rss'
import { getThemeBootstrapScript } from '@/lib/theme/constants'
import { pageTransition } from '@/lib/view-transition'

import '@/styles/globals.css'

const locale = (Astro.locals.locale ?? 'en') as Locale
const rssZh = getMessages('zh').blog
const rssEn = getMessages('en').blog
const rssJa = getMessages('ja').blog

const isOnDesignPage = Astro.url.pathname === '/design'
const designFavicon = isOnDesignPage
	? await getImage({ format: 'png', height: 64, src: shinyImi, width: 64 })
	: null
---

<!doctype html>
<html lang={htmlLangFor(locale)}>
	<head>
		<meta charset="utf-8" />
		<meta content="width=device-width, initial-scale=1" name="viewport" />
		<meta content="#ffffff" media="(prefers-color-scheme: light)" name="theme-color" />
		<meta content="#252529" media="(prefers-color-scheme: dark)" name="theme-color" />

		<link crossorigin="anonymous" href="https://avatars.githubusercontent.com" rel="preconnect" />
		<link href="/site.webmanifest" rel="manifest" />
		<link as="font" crossorigin="anonymous" href="/fonts/hanken-grotesk-vf.woff2" rel="preload" type="font/woff2" />

		<link href={RSS_FEED_URL} hreflang="zh" rel="alternate" title={rssZh.pageTitle} type="application/rss+xml" />
		<link href={RSS_FEED_URL_EN} hreflang="en" rel="alternate" title={rssEn.pageTitle} type="application/rss+xml" />
		<link href={RSS_FEED_URL_JA} hreflang="ja" rel="alternate" title={rssJa.pageTitle} type="application/rss+xml" />

		{designFavicon
			? <link href={designFavicon.src} rel="icon" type="image/png" />
			: (
					<>
						<link href="/favicon.ico" rel="icon" sizes="32x32" />
						<link href="/icon.svg" rel="icon" type="image/svg+xml" />
					</>
				)}
		<link href={designFavicon?.src ?? '/apple-touch-icon.png'} rel="apple-touch-icon" />

		<script set:html={getThemeBootstrapScript()} is:inline />

		<MisansUi />
		<ClientRouter />

		<slot name="head" />
	</head>
	<body class="relative isolate min-h-screen">
		<div class="page-shell min-h-screen" data-site-locale={locale} transition:animate={pageTransition}>
			<main class="min-h-screen">
				<slot />
			</main>
		</div>
		<Footer locale={locale} transition:persist="site-footer" />
	</body>
</html>

<script>
import '@/scripts/site-client'
</script>
