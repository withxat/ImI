---
import type { Locale } from '@/lib/i18n/constants'
import type { ColorGroupKey, ColorRoleKey, TypographyScaleRoleKey } from '@/lib/i18n/messages/types'

import { Image } from 'astro:assets'

import shinyImi from '@/assets/shiny-imi.png'
import shinyTf from '@/assets/shiny-tf.png'
import Container from '@/components/container.astro'
import HomeCardLink from '@/components/home-card-link.astro'
import Seo from '@/components/seo.astro'
import SiteHeader from '@/components/site-header.astro'
import TextLink from '@/components/text-link.astro'
import { Badge } from '@/components/ui/badge'
import { Button } from '@/components/ui/button'
import RootLayout from '@/layouts/root-layout.astro'
import { getMessages } from '@/lib/i18n/messages'

const locale = (Astro.locals.locale ?? 'en') as Locale
const m = getMessages(locale)

interface ColorToken {
	name: string
	role: ColorRoleKey
	var: string
}

const colorGroups: { key: ColorGroupKey, tokens: ColorToken[] }[] = [
	{
		key: 'surface',
		tokens: [
			{ name: 'background', role: 'background', var: '--background' },
			{ name: 'surface', role: 'surface', var: '--surface' },
			{ name: 'card', role: 'card', var: '--card' },
			{ name: 'popover', role: 'popover', var: '--popover' },
		],
	},
	{
		key: 'content',
		tokens: [
			{ name: 'foreground', role: 'foreground', var: '--foreground' },
			{ name: 'muted-foreground', role: 'mutedForeground', var: '--muted-foreground' },
			{ name: 'primary', role: 'primary', var: '--primary' },
		],
	},
	{
		key: 'washEdges',
		tokens: [
			{ name: 'muted', role: 'muted', var: '--muted' },
			{ name: 'accent', role: 'accent', var: '--accent' },
			{ name: 'border', role: 'border', var: '--border' },
		],
	},
	{
		key: 'highlight',
		tokens: [
			{ name: 'highlight-soft', role: 'highlightSoft', var: '--highlight-soft' },
			{ name: 'highlight-text', role: 'highlightText', var: '--highlight-text' },
			{ name: 'highlight-icon', role: 'highlightIcon', var: '--highlight-icon' },
		],
	},
	{
		key: 'status',
		tokens: [
			{ name: 'destructive', role: 'destructive', var: '--destructive' },
			{ name: 'info', role: 'info', var: '--info' },
			{ name: 'success', role: 'success', var: '--success' },
			{ name: 'warning', role: 'warning', var: '--warning' },
		],
	},
]

const typographyScaleOrder: TypographyScaleRoleKey[] = [
	'display',
	'headline',
	'title',
	'body',
	'label',
	'mono',
	'bioLead',
	'wordmark',
]

const typographyScaleClass: Record<TypographyScaleRoleKey, string> = {
	bioLead: 'font-serif text-base/7 font-semibold text-foreground',
	body: 'text-base/7 text-foreground',
	display: 'text-3xl font-medium text-foreground',
	headline: 'text-2xl font-medium text-foreground',
	label: 'text-sm font-medium text-foreground',
	mono: 'font-mono text-xs text-foreground',
	title: 'text-lg font-semibold text-foreground',
	wordmark: 'font-fugaz-one text-3xl text-highlight-strong',
}

const typographyScaleSample: Record<TypographyScaleRoleKey, string> = {
	bioLead: m.home.bioLead,
	body: m.home.bioP1,
	display: 'The quick brown fox',
	headline: m.design.typography.title,
	label: m.home.writingEyebrow,
	mono: 'const theme = "dark"',
	title: m.home.capabilitiesEyebrow,
	wordmark: 'Xat',
}
---

<RootLayout>
	<Seo
		canonicalPath="/design"
		description={m.design.pageDescription}
		locale={locale}
		slot="head"
		title={m.design.pageTitle}
	/>

	<section>
		<Container class="page-shell">
			<div class="space-y-8">
				<SiteHeader locale={locale} messages={m} showBack />

				<div class="flex flex-col space-y-24">
					<!-- Hero -->
					<div class="flex flex-col gap-1">
						<button
							class="
								relative inline-block size-8 cursor-pointer rounded-md border-0 bg-transparent p-0 transition-transform duration-150
								ease-out outline-none perspective-near
								focus-visible:ring-2 focus-visible:ring-ring/50
								active:scale-97
							"
							aria-label={m.design.flipMascot}
							aria-pressed="false"
							type="button"
							data-shiny-coin
						>
							<span
								class="relative block size-full transform-3d"
								data-shiny-coin-inner
							>
								<Image
									alt="shiny-imi"
									class="absolute inset-0 size-full backface-hidden"
									loading="eager"
									src={shinyImi}
								/>
								<Image
									alt="shiny-tf"
									class="absolute inset-0 size-full rotate-y-180 backface-hidden"
									loading="eager"
									src={shinyTf}
								/>
							</span>
						</button>
						<h1 class="inline-flex items-end text-3xl font-medium text-foreground">
							{m.design.eyebrow}
						</h1>
					</div>

					<!-- 1. Overview -->
					<section class="space-y-6">
						<h2 class="text-2xl font-medium text-foreground">{m.design.northStar.title}</h2>
						<p class="max-w-prose text-base/7 text-muted-foreground">
							{m.design.northStar.tagline}
						</p>
						<ul class="max-w-prose list-inside list-disc space-y-2 text-sm text-muted-foreground">
							{m.design.northStar.characteristics.map(item => (
								<li>{item}</li>
							))}
						</ul>
					</section>

					<!-- 2. Typography -->
					<section class="space-y-8">
						<h2 class="text-2xl font-medium text-foreground">{m.design.typography.title}</h2>

						<div class="space-y-4">
							<h3 class="text-lg font-medium text-foreground">{m.design.typography.scaleTitle}</h3>
							<ul class="divide-y divide-border rounded-xl border border-border">
								{typographyScaleOrder.map((role) => {
									const row = m.design.typography.scale[role]
									return (
										<li class="
											flex flex-col gap-2 px-5 py-4
											sm:flex-row sm:items-baseline sm:justify-between
										"
										>
											<div class="min-w-0 space-y-0.5">
												<p class="font-mono text-xs text-muted-foreground">{row.spec}</p>
												<p class="text-sm font-medium text-muted-foreground">{row.role}</p>
											</div>
											<p class={typographyScaleClass[role]}>{typographyScaleSample[role]}</p>
										</li>
									)
								})}
							</ul>
						</div>
					</section>

					<!-- 3. Colors -->
					<section class="space-y-8">
						<div class="space-y-3">
							<h2 class="text-2xl font-medium text-foreground">{m.design.colors.title}</h2>
							<p class="max-w-prose text-base/7 text-muted-foreground">
								{m.design.colors.intro}
							</p>
						</div>

						<div class="space-y-12">
							{colorGroups.map((group) => {
								const groupCopy = m.design.colors.groups[group.key]
								return (
									<div class="space-y-5">
										<div class="space-y-1.5">
											<h3 class="text-lg font-medium text-foreground">{groupCopy.title}</h3>
											<p class="max-w-prose text-sm text-muted-foreground">{groupCopy.description}</p>
										</div>

										<div class="
											grid grid-cols-1 gap-6
											lg:grid-cols-2
										"
										>
											{(['light', 'dark'] as const).map((mode) => {
												const scopeClass = mode === 'light' ? 'theme-light' : 'theme-dark'
												return (
													<div class={`
														${scopeClass}
														overflow-hidden rounded-xl border border-border bg-background
													`}
													>
														<div class="flex items-center justify-between border-b border-border px-5 py-3">
															<p class="font-mono text-xs font-medium text-muted-foreground">.{mode}</p>
														</div>
														<ul class="divide-y divide-border">
															{group.tokens.map(token => (
																<li
																	class="flex items-center gap-4 px-5 py-3.5"
																	data-color-row={token.var}
																>
																	<span
																		aria-hidden="true"
																		class="size-11 shrink-0 rounded-md border border-border"
																		style={`background: var(${token.var})`}
																	/>
																	<div class="min-w-0 flex-1 space-y-0.5">
																		<p class="truncate text-sm font-medium text-foreground">{token.name}</p>
																		<p class="truncate text-xs text-muted-foreground">{m.design.colors.roles[token.role]}</p>
																		<code
																			class="block truncate font-mono text-[10.5px] text-muted-foreground/85 tabular-nums"
																			data-color-value
																		>
																			—
																		</code>
																	</div>
																</li>
															))}
														</ul>
													</div>
												)
											})}
										</div>
									</div>
								)
							})}
						</div>
					</section>

					<!-- 4. Elevation -->
					<section class="space-y-6">
						<div class="space-y-3">
							<h2 class="text-2xl font-medium text-foreground">{m.design.elevation.title}</h2>
							<p class="max-w-prose text-base/7 text-muted-foreground">{m.design.elevation.intro}</p>
							<p class="max-w-prose text-sm text-muted-foreground">{m.design.elevation.flatNote}</p>
						</div>
						<div class="
							grid gap-4
							sm:grid-cols-2
						"
						>
							<div class="rounded-xl border border-border bg-background px-5 py-6 shadow-xs shadow-highlight-soft/30">
								<p class="font-mono text-xs text-muted-foreground">{m.design.elevation.shadowXs}</p>
								<p class="mt-3 text-sm text-foreground">highlight-surface</p>
							</div>
							<div class="rounded-xl border border-highlight-soft/75 bg-background px-5 py-6 shadow-soft">
								<p class="font-mono text-xs text-muted-foreground">{m.design.elevation.shadowSoft}</p>
								<p class="mt-3 text-sm text-foreground">shadow-soft</p>
							</div>
						</div>
					</section>

					<!-- 5. Components -->
					<section class="space-y-8">
						<h2 class="text-2xl font-medium text-foreground">{m.design.components.title}</h2>

						<div class="space-y-4">
							<h3 class="text-lg font-medium text-foreground">{m.design.components.buttonsLabel}</h3>
							<div class="flex flex-wrap items-center gap-3">
								<Button>Default</Button>
								<Button variant="secondary">Secondary</Button>
								<Button variant="outline">Outline</Button>
								<Button variant="ghost">Ghost</Button>
								<Button variant="destructive">Destructive</Button>
							</div>
						</div>

						<div class="space-y-4">
							<h3 class="text-lg font-medium text-foreground">{m.design.components.badgesLabel}</h3>
							<div class="flex flex-wrap items-center gap-2">
								<Badge>Default</Badge>
								<Badge variant="secondary">Secondary</Badge>
								<Badge variant="outline">Outline</Badge>
								<Badge variant="destructive">Destructive</Badge>
							</div>
						</div>

						<div class="space-y-4">
							<h3 class="text-lg font-medium text-foreground">{m.design.components.linksLabel}</h3>
							<p class="text-base/7 text-muted-foreground">
								<TextLink href="/post">{m.home.viewAllPosts}</TextLink>
								{' '}
								<span class="text-muted-foreground">·</span>
								{' '}
								<a class="text-link-muted text-sm" href="/">{m.header.goHome}</a>
							</p>
						</div>

						<div class="space-y-4">
							<h3 class="text-lg font-medium text-foreground">{m.design.components.surfacesLabel}</h3>
							<HomeCardLink
								description={m.design.components.cardDescription}
								href="/"
								title={m.design.components.cardTitle}
							/>
						</div>
					</section>

					<!-- 6. Named rules -->
					<section class="space-y-6">
						<h2 class="text-2xl font-medium text-foreground">{m.design.principles.title}</h2>
						<ul class="space-y-4">
							{m.design.principles.rules.map(rule => (
								<li class="surface-callout px-5 py-4">
									<p class="text-sm font-semibold text-foreground">{rule.name}</p>
									<p class="mt-1 text-sm text-muted-foreground">{rule.body}</p>
								</li>
							))}
						</ul>
					</section>
				</div>
			</div>
		</Container>
	</section>
</RootLayout>

<script>
import { animate } from 'motion'

import { onAstroPageLoad } from '@/lib/astro-page-lifecycle'

const FLIP_DURATION_S = 0.7
const FLIP_EASE: [number, number, number, number] = [0.77, 0, 0.175, 1]

onAstroPageLoad(() => {
	const rows = document.querySelectorAll<HTMLElement>('[data-color-row]')
	rows.forEach((row) => {
		const varName = row.dataset.colorRow
		if (!varName)
			return
		const value = getComputedStyle(row).getPropertyValue(varName).trim()
		const target = row.querySelector<HTMLElement>('[data-color-value]')
		if (target && value)
			target.textContent = value
	})

	const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)')
	const coins = document.querySelectorAll<HTMLButtonElement>('[data-shiny-coin]')
	for (const button of coins) {
		const inner = button.querySelector<HTMLElement>('[data-shiny-coin-inner]')
		if (!inner)
			continue

		let rotation = 0
		let isFlipping = false

		button.addEventListener('click', () => {
			if (isFlipping)
				return

			const from = rotation
			const to = rotation + 180
			rotation = to
			button.setAttribute('aria-pressed', String((to / 180) % 2 === 1))

			if (reducedMotion.matches) {
				inner.style.transform = `rotateY(${to}deg)`
				return
			}

			isFlipping = true
			animate(
				inner,
				{
					rotateY: [from, to],
					scale: [1, 1.4, 1],
					y: [0, -6, 0],
				},
				{
					duration: FLIP_DURATION_S,
					ease: FLIP_EASE,
				},
			).finished.finally(() => {
				isFlipping = false
			})
		})
	}
})
</script>
