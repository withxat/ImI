---
import type { Locale } from '@/lib/i18n/constants'
import type { ColorGroupKey, ColorRoleKey, TypefaceKey, TypographyScaleRoleKey } from '@/lib/i18n/messages/types'

import { Image } from 'astro:assets'
import List from '~icons/lucide/list'

import shinyImi from '@/assets/shiny-imi.png'
import shinyTf from '@/assets/shiny-tf.png'
import Container from '@/components/layout/container.astro'
import SiteHeader from '@/components/layout/site-header.astro'
import Seo from '@/components/meta/seo.astro'
import { Button } from '@/components/ui/button'
import RootLayout from '@/layouts/root-layout.astro'
import { CJK_WEIGHTS } from '@/lib/fonts/cjk-font-polish'
import { htmlLangFor } from '@/lib/i18n/constants'
import { getMessages } from '@/lib/i18n/messages'
import { pageOgImageUrl } from '@/lib/seo-data'

const locale = (Astro.locals.locale ?? 'en') as Locale
const m = getMessages(locale)

const wrapSamples = [
	{
		lang: 'en',
		rule: 'text-wrap: pretty · hyphens: manual',
		text: `${getMessages('en').home.metaDescription} ${getMessages('en').blog.pageDescription}`,
	},
	{
		lang: 'zh',
		rule: 'text-wrap: wrap · hyphens: none',
		text: `${getMessages('zh').home.metaDescription}${getMessages('zh').blog.pageDescription}`,
	},
	{
		lang: 'ja',
		rule: 'line-break: strict · hyphens: none',
		text: `${getMessages('ja').home.metaDescription}${getMessages('ja').blog.pageDescription}`,
	},
] as const

const radiiTokens = [
	{ class: 'rounded-sm', name: 'sm' },
	{ class: 'rounded-md', name: 'md' },
	{ class: 'rounded-lg', name: 'lg' },
	{ class: 'rounded-xl', name: 'xl' },
	{ class: 'rounded-full', name: 'full' },
] as const

// Families as `document.fonts` names them; `src/client/design-specimens.ts`
// fills in weights, styles, and @font-face counts at runtime.
const typefaces: { family: string, glyph: string, glyphClass: string, key: TypefaceKey }[] = [
	{ family: 'Hanken Grotesk', glyph: 'Aa', glyphClass: 'font-ui font-medium text-foreground', key: 'hankenGrotesk' },
	{ family: 'MiSans', glyph: '字あ', glyphClass: 'font-ui font-medium text-foreground', key: 'miSans' },
	{ family: 'Calling Code', glyph: 'Aa', glyphClass: 'font-mono text-foreground', key: 'callingCode' },
	{ family: 'Source Han Serif SC VF', glyph: 'Aa', glyphClass: 'font-serif font-semibold text-foreground', key: 'sourceHanSerif' },
	{ family: 'Fugaz One', glyph: 'Xat', glyphClass: 'font-fugaz-one text-highlight-brand', key: 'fugazOne' },
]

// Each sample uses the classes and copy the site actually renders in that role;
// the spec beside it is read from the sample's computed style.
const typeScale: { class: string, lang?: string, role: TypographyScaleRoleKey, sample: string }[] = [
	{ class: 'text-3xl font-medium text-foreground', role: 'display', sample: m.blog.title },
	{ class: 'text-2xl font-medium text-foreground', role: 'headline', sample: m.design.eyebrow },
	{ class: 'text-lg/6 font-semibold tracking-tight text-foreground', role: 'title', sample: m.capabilities[1]?.title ?? m.design.typography.title },
	{ class: 'max-w-prose text-base/7 text-foreground', role: 'body', sample: m.home.metaDescription },
	{ class: 'text-sm font-medium text-foreground', role: 'label', sample: m.home.viewAllPosts },
	{ class: 'font-mono text-xs text-foreground', role: 'mono', sample: '01 02 03 04' },
	// The serif subset only carries the glyphs of the home bio lead, so the sample must be that exact line.
	{ class: 'home-bio-lead max-w-prose font-serif text-base/7 font-semibold text-foreground', lang: htmlLangFor(locale), role: 'bioLead', sample: m.home.bioLead },
	{ class: 'font-fugaz-one text-3xl text-highlight-brand', role: 'wordmark', sample: 'Xat' },
]

// The weight scale's CJK text is set in the 'MiSans Weight Demo' VF subset
// (public/fonts/misans-vf-weight-demo-subset.woff2), which only carries these glyphs plus 字.
const weightSampleCjk = '设计系统 デザインシステム'
const weightSampleLatin = 'Design System'
// Each step hands its pair to the CSS; matching off swaps MiSans to Hanken's number.
// The balance shows the heaviest step, and its tilt grows with how far wght sits below that number.
function weightStepStyle({ latin, wght }: { latin: number, wght: number }) {
	return `--latin: ${latin}; --wght: ${wght}; --tilt: ${((latin - wght) / 12).toFixed(2)}deg`
}
const scaleStep = CJK_WEIGHTS[CJK_WEIGHTS.length - 1]!

interface ColorToken {
	/** Text roles show WCAG contrast against this token (the surface they sit on). */
	against?: string
	name: string
	role: ColorRoleKey
	var: string
}

const colorGroups: { key: Exclude<ColorGroupKey, 'status'>, tokens: ColorToken[] }[] = [
	{
		key: 'surface',
		tokens: [
			{ name: 'background', role: 'background', var: '--background' },
			{ name: 'surface', role: 'surface', var: '--surface' },
		],
	},
	{
		key: 'content',
		tokens: [
			{ against: '--background', name: 'foreground', role: 'foreground', var: '--foreground' },
			{ against: '--background', name: 'muted-foreground', role: 'mutedForeground', var: '--muted-foreground' },
		],
	},
	{
		key: 'washEdges',
		tokens: [
			{ name: 'muted', role: 'muted', var: '--muted' },
			{ name: 'border', role: 'border', var: '--border' },
		],
	},
	{
		key: 'highlight',
		tokens: [
			{ against: '--background', name: 'highlight-text', role: 'highlightText', var: '--highlight-text' },
			{ against: '--background', name: 'highlight-brand', role: 'highlightBrand', var: '--highlight-brand' },
			{ name: 'highlight-soft', role: 'highlightSoft', var: '--highlight-soft' },
			{ against: '--background', name: 'highlight-icon', role: 'highlightIcon', var: '--highlight-icon' },
			{ name: 'selection', role: 'selection', var: '--selection' },
		],
	},
	{
		key: 'code',
		tokens: [
			{ name: 'code', role: 'code', var: '--code' },
			{ against: '--code', name: 'code-foreground', role: 'codeForeground', var: '--code-foreground' },
		],
	},
]

const statusTokens = ['destructive', 'info', 'success', 'warning']

const colorModes = [
	{ key: 'light', scope: 'theme-light' },
	{ key: 'dark', scope: 'theme-dark' },
] as const

const designSections = [
	{ id: 'typography', label: m.design.typography.title },
	{ id: 'colors', label: m.design.colors.title },
	{ id: 'wrapping', label: m.design.wrapping.title },
	{ id: 'geometry', label: m.design.geometry.title },
	{ id: 'motion', label: m.design.motion.title },
]

const sectionHeadingClass = 'scroll-mt-8 text-2xl font-medium text-foreground focus:outline-none'
const colorGrid = 'grid grid-cols-2 items-center gap-x-4 gap-y-3 @lg/page:grid-cols-[minmax(0,1fr)_12rem_12rem]'
---

<RootLayout>
	<Seo
		canonicalPath="/design"
		description={m.design.pageDescription}
		image={pageOgImageUrl('design')}
		locale={locale}
		slot="head"
		title={m.design.pageTitle}
	/>

	<section>
		<Container class="page-shell">
			<div class="space-y-8">
				<SiteHeader locale={locale} messages={m} showBack />

				<div class="flex flex-col space-y-24">
					<!-- Hero -->
					<div class="flex flex-col gap-1">
						<button
							class="
								relative inline-block size-8 cursor-pointer rounded-md border-0 bg-transparent p-0 transition-transform duration-150
								ease-out perspective-near
								active:scale-97
							"
							aria-label={m.design.flipMascot}
							aria-pressed="false"
							type="button"
							data-shiny-coin
						>
							<span
								class="relative block size-full transform-3d"
								data-shiny-coin-inner
							>
								<Image
									alt="shiny-imi"
									class="absolute inset-0 size-full backface-hidden"
									loading="eager"
									src={shinyImi}
								/>
								<Image
									alt="shiny-tf"
									class="absolute inset-0 size-full rotate-y-180 backface-hidden"
									loading="eager"
									src={shinyTf}
								/>
							</span>
						</button>
						<div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
							<h1 class="inline-flex items-end text-3xl font-medium text-foreground">
								{m.design.eyebrow}
							</h1>
							<button
								class="
									inline-flex cursor-pointer items-center gap-1 rounded-full bg-muted px-2.5 py-1 font-ui text-xs
									text-muted-foreground transition-colors duration-150
									hover:bg-highlight-soft/25 hover:text-highlight-strong
									aria-expanded:bg-highlight-soft/25 aria-expanded:text-foreground
									dark:hover:bg-foreground/10
									dark:aria-expanded:bg-foreground/10
									print:hidden
								"
								aria-controls="design-sections"
								aria-expanded="false"
								type="button"
								data-section-outline-trigger
							>
								<List aria-hidden="true" class="size-3.5 shrink-0 opacity-75" />
								<span>{m.blog.sectionCount(designSections.length)}</span>
							</button>
						</div>
						<nav
							class="
								mt-3 font-ui text-sm
								print:hidden
							"
							aria-label={m.blog.toc}
							id="design-sections"
							hidden
						>
							<ol class="flex flex-wrap gap-x-4 gap-y-1.5">
								{designSections.map(section => (
									<li>
										<a
											class="
												text-muted-foreground transition-colors duration-150
												hover:text-foreground
											"
											href={`#${section.id}`}
										>
											{section.label}
										</a>
									</li>
								))}
							</ol>
						</nav>
					</div>

					<!-- 1. Typography -->
					<section class="space-y-10">
						<h2 class={sectionHeadingClass} id="typography" tabindex="-1">{m.design.typography.title}</h2>

						<ul class="divide-y divide-border border-y border-border">
							{typefaces.map(face => (
								<li
									class="grid grid-cols-[5rem_minmax(0,1fr)] items-center gap-4 py-4"
									data-face-family={face.family}
								>
									<span
										class={`
											text-4xl/none whitespace-nowrap
											${face.glyphClass}
										`}
										aria-hidden="true"
									>
										{face.glyph}
									</span>
									<div class="min-w-0 space-y-1">
										<p class="flex flex-wrap items-baseline gap-x-2.5 gap-y-0.5 text-sm">
											<span class="font-medium text-foreground">{face.family}</span>
											<span class="text-muted-foreground">{m.design.typography.families[face.key]}</span>
										</p>
										<p class="min-h-4 font-mono text-xs text-muted-foreground tabular-nums" data-face-facts />
									</div>
								</li>
							))}
						</ul>

						<div class="space-y-3" data-weight-match="on" data-weight-demo>
							<div class="flex flex-wrap items-center justify-between gap-3">
								<h3 class="text-lg font-medium text-foreground">{m.design.typography.weightsTitle}</h3>
								<div class="flex items-center gap-3">
									<svg
										aria-hidden="true"
										class="h-12 w-[4.3rem] overflow-visible text-muted-foreground"
										fill="none"
										stroke="currentColor"
										stroke-linecap="round"
										stroke-width="1.5"
										style={weightStepStyle(scaleStep)}
										viewBox="0 0 80 56"
										data-weight-step
									>
										<path d="M40 16V52M31 52H49" />
										<path d="M12 14H68" data-scale-beam />
										<circle class="fill-highlight-brand stroke-none" cx="40" cy="14" r="2.5" />
										<g data-scale-pan="cjk">
											<path d="M12 14V18M2 33Q12 40 22 33" />
											<text class="fill-foreground stroke-none text-[13px]" text-anchor="middle" x="12" y="30.5" data-weight-cjk>字</text>
										</g>
										<g data-scale-pan="latin">
											<path d="M68 14V18M58 33Q68 40 78 33" />
											<text class="fill-foreground stroke-none text-[13px] font-(--latin)" text-anchor="middle" x="68" y="30.5">Aa</text>
										</g>
									</svg>
									<Button
										aria-pressed="true"
										class="font-mono text-xs"
										data-label-off={m.design.typography.weightsMatchOff}
										data-label-on={m.design.typography.weightsMatchOn}
										size="sm"
										type="button"
										variant="outline"
										data-weight-toggle
									>
										{m.design.typography.weightsMatchOn}
									</Button>
								</div>
							</div>
							<p class="max-w-prose text-sm text-muted-foreground">{m.design.typography.weightsNote}</p>
							<ul class="divide-y divide-border border-y border-border">
								{CJK_WEIGHTS.map(step => (
									<li class="space-y-2 py-4" style={weightStepStyle(step)} data-weight-step>
										<p class="font-mono text-xs text-muted-foreground tabular-nums">
											Hanken {step.latin} · MiSans wght <span data-weight-readout />
										</p>
										<p class="text-2xl font-(--latin) text-foreground">
											<span data-weight-cjk>{weightSampleCjk}</span> {weightSampleLatin}
										</p>
									</li>
								))}
							</ul>
						</div>

						<div class="space-y-3">
							<h3 class="text-lg font-medium text-foreground">{m.design.typography.scaleTitle}</h3>
							<ul class="divide-y divide-border border-y border-border">
								{typeScale.map(row => (
									<li class="space-y-3 py-5" data-type-row>
										<div class="
											flex flex-col gap-1
											@lg/page:flex-row @lg/page:flex-wrap @lg/page:items-baseline @lg/page:justify-between @lg/page:gap-x-6
										"
										>
											<p class="text-sm font-medium text-foreground">{m.design.typography.scale[row.role]}</p>
											<p class="min-h-4 font-mono text-xs text-muted-foreground tabular-nums" data-type-spec />
										</div>
										<p class={row.class} lang={row.lang} data-type-sample>{row.sample}</p>
									</li>
								))}
							</ul>
						</div>
					</section>

					<!-- 2. Colors -->
					<section class="space-y-10" data-color-copied={m.design.colors.copied}>
						<div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
							<h2 class={sectionHeadingClass} id="colors" tabindex="-1">{m.design.colors.title}</h2>
							<p class="font-mono text-xs text-muted-foreground">OKLCH (L C H / α)</p>
						</div>

						<div class="space-y-10">
							{colorGroups.map(group => (
								<div class="space-y-2">
									<div class={`
										${colorGrid}
										text-xs text-muted-foreground
									`}
									>
										<h3 class="
											col-span-2 text-sm font-medium text-foreground
											@lg/page:col-span-1
										"
										>
											{m.design.colors.groups[group.key]}
										</h3>
										{colorModes.map(mode => (
											<p aria-hidden="true">{m.design.colors.modeLabel[mode.key]}</p>
										))}
									</div>
									<ul class="divide-y divide-border border-y border-border">
										{group.tokens.map(token => (
											<li class={`
												${colorGrid}
												py-3.5
											`}
											>
												<div class="
													col-span-2 min-w-0
													@lg/page:col-span-1
												"
												>
													<button
														class="
															block cursor-pointer text-left font-mono text-xs text-foreground transition-colors duration-150
															hover:text-highlight-strong
															focus-visible:rounded-sm
														"
														aria-label={m.design.colors.copyToken(token.var)}
														data-copy-token={token.var}
														type="button"
													>
														{token.name}
													</button>
													<p class="mt-1 text-sm text-muted-foreground">{m.design.colors.roles[token.role]}</p>
												</div>
												{colorModes.map(mode => (
													<button
														class="
															group/swatch flex min-w-0 cursor-pointer items-center gap-3 rounded-md text-left
															focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring
														"
														aria-label={m.design.colors.copyValue(token.name, m.design.colors.modeLabel[mode.key])}
														data-color-against={token.against}
														data-color-token={token.var}
														type="button"
													>
														<span
															class={`
																${mode.scope}
																grid size-8 shrink-0 place-items-center rounded-md text-sm font-medium shadow-[inset_0_0_0_1px_var(--border)] transition-transform duration-150
																group-hover/swatch:scale-105
																group-active/swatch:scale-95
																motion-reduce:transition-none
															`}
															style={token.against
																? `background-color: var(${token.against}); color: var(${token.var})`
																: `background: linear-gradient(var(${token.var}), var(${token.var})), var(--background)`}
															aria-hidden="true"
															data-color-scope
														>
															{token.against && 'Aa'}
														</span>
														<span class="min-w-0 font-mono text-xs tabular-nums">
															<span class="sr-only">{m.design.colors.modeLabel[mode.key]}</span>
															<span
																class="
																	block text-foreground transition-colors duration-150
																	group-hover/swatch:text-highlight-strong
																"
																data-color-value
															>—</span>
															{token.against && <span class="block min-h-4 text-muted-foreground" data-color-contrast />}
														</span>
													</button>
												))}
											</li>
										))}
									</ul>
								</div>
							))}

							<div class="space-y-2">
								<div class={`
									${colorGrid}
									text-xs text-muted-foreground
								`}
								>
									<h3 class="
										col-span-2 text-sm font-medium text-foreground
										@lg/page:col-span-1
									"
									>
										{m.design.colors.groups.status}
									</h3>
									{colorModes.map(mode => (
										<p aria-hidden="true">{m.design.colors.modeLabel[mode.key]}</p>
									))}
								</div>
								<div class={`
									${colorGrid}
									border-y border-border py-3.5
								`}
								>
									<div class="
										col-span-2 min-w-0
										@lg/page:col-span-1
									"
									>
										<p class="font-mono text-xs text-foreground">{statusTokens.join(', ')}</p>
										<p class="mt-1 text-sm text-muted-foreground">{m.design.colors.roles.status}</p>
									</div>
									{colorModes.map(mode => (
										<div
											class={`
												${mode.scope}
												flex gap-1.5
											`}
											aria-hidden="true"
										>
											{statusTokens.map(name => (
												<span class="size-5 rounded-sm" style={`background-color: var(--${name})`} />
											))}
										</div>
									))}
								</div>
							</div>
						</div>
					</section>

					<!-- 3. Trilingual wrapping -->
					<section class="space-y-6" data-wrap-rules="on" data-wrap-demo>
						<div class="flex flex-wrap items-center justify-between gap-3">
							<h2 class={sectionHeadingClass} id="wrapping" tabindex="-1">{m.design.wrapping.title}</h2>
							<div class="flex flex-wrap items-center gap-3">
								<label class="flex items-center gap-2 font-mono text-xs text-muted-foreground tabular-nums">
									<span class="sr-only">{m.design.wrapping.widthLabel}</span>
									<input
										aria-label={m.design.wrapping.widthLabel}
										class="w-24 accent-foreground"
										max="39"
										min="16"
										step="1"
										type="range"
										value="26"
										data-wrap-slider
									/>
									<span class="w-10 text-right" data-wrap-width>26rem</span>
								</label>
								<Button
									aria-pressed="true"
									class="font-mono text-xs"
									data-label-off={m.design.wrapping.rulesOff}
									data-label-on={m.design.wrapping.rulesOn}
									size="sm"
									type="button"
									variant="outline"
									data-wrap-toggle
								>
									{m.design.wrapping.rulesOn}
								</Button>
							</div>
						</div>

						<div class="border-y border-border py-5">
							<div class="space-y-5 border-r border-dashed border-border pr-4" data-wrap-stage>
								{wrapSamples.map(sample => (
									<div class="space-y-1">
										<p class="font-mono text-xs text-muted-foreground">
											:lang({sample.lang}) · {sample.rule}
										</p>
										<p class="text-base/7 text-foreground" lang={sample.lang}>{sample.text}</p>
									</div>
								))}
							</div>
						</div>
					</section>

					<!-- 4. Shape & shadow -->
					<section class="space-y-8">
						<h2 class={sectionHeadingClass} id="geometry" tabindex="-1">{m.design.geometry.title}</h2>

						<div class="space-y-3">
							<h3 class="text-sm font-medium text-foreground">{m.design.geometry.radiiTitle}</h3>
							<ul class="
								grid grid-cols-3 gap-4 border-y border-border py-5
								@lg/page:grid-cols-5
							"
							>
								{radiiTokens.map(radius => (
									<li class="flex flex-col items-start gap-2" data-radius-row>
										<span
											class={`
												size-12 border border-border bg-muted/60
												${radius.class}
											`}
											aria-hidden="true"
											data-radius-sample
										/>
										<div class="font-mono text-xs/4 tabular-nums">
											<p class="text-foreground">{radius.name}</p>
											<p class="min-h-4 text-muted-foreground" data-radius-value>—</p>
										</div>
									</li>
								))}
							</ul>
						</div>

						<div class="space-y-3">
