---
import type { Locale } from '@/lib/i18n/constants'
import type { ColorGroupKey, ColorRoleKey, TypographyScaleRoleKey } from '@/lib/i18n/messages/types'

import { Image } from 'astro:assets'

import shinyImi from '@/assets/shiny-imi.png'
import shinyTf from '@/assets/shiny-tf.png'
import ComponentPreviewCanvas from '@/components/design/component-preview-canvas.astro'
import HomeCardLink from '@/components/home/home-card-link.astro'
import Container from '@/components/layout/container.astro'
import SiteHeader from '@/components/layout/site-header.astro'
import TextLink from '@/components/layout/text-link.astro'
import Seo from '@/components/meta/seo.astro'
import RootLayout from '@/layouts/root-layout.astro'
import { getMessages } from '@/lib/i18n/messages'
import { pageOgImageUrl } from '@/lib/seo-data'

const locale = (Astro.locals.locale ?? 'en') as Locale
const m = getMessages(locale)

interface ColorToken {
	name: string
	role: ColorRoleKey
	var: string
}

const colorGroups: { key: ColorGroupKey, tokens: ColorToken[] }[] = [
	{
		key: 'surface',
		tokens: [
			{ name: 'background', role: 'background', var: '--background' },
			{ name: 'surface', role: 'surface', var: '--surface' },
			{ name: 'card', role: 'card', var: '--card' },
			{ name: 'popover', role: 'popover', var: '--popover' },
		],
	},
	{
		key: 'content',
		tokens: [
			{ name: 'foreground', role: 'foreground', var: '--foreground' },
			{ name: 'muted-foreground', role: 'mutedForeground', var: '--muted-foreground' },
			{ name: 'primary', role: 'primary', var: '--primary' },
		],
	},
	{
		key: 'washEdges',
		tokens: [
			{ name: 'muted', role: 'muted', var: '--muted' },
			{ name: 'accent', role: 'accent', var: '--accent' },
			{ name: 'border', role: 'border', var: '--border' },
		],
	},
	{
		key: 'highlight',
		tokens: [
			{ name: 'highlight-soft', role: 'highlightSoft', var: '--highlight-soft' },
			{ name: 'highlight-text', role: 'highlightText', var: '--highlight-text' },
			{ name: 'highlight-icon', role: 'highlightIcon', var: '--highlight-icon' },
		],
	},
	{
		key: 'status',
		tokens: [
			{ name: 'destructive', role: 'destructive', var: '--destructive' },
			{ name: 'info', role: 'info', var: '--info' },
			{ name: 'success', role: 'success', var: '--success' },
			{ name: 'warning', role: 'warning', var: '--warning' },
		],
	},
]

const typographyScaleOrder: TypographyScaleRoleKey[] = [
	'display',
	'headline',
	'title',
	'body',
	'label',
	'mono',
	'bioLead',
	'wordmark',
]

type FontSpecimenDescriptor = 'accent' | 'cjk' | 'display' | 'mono' | 'serif'

interface FontSpecimen {
	descriptor: FontSpecimenDescriptor
	font: string
	sampleClass: string
	samples: { italic?: boolean, text: string }[]
}

const colorTabsBootstrap = `(function(){var c=document.querySelectorAll('[data-color-card]');if(!c.length)return;var m=document.documentElement.classList.contains('dark')?'dark':'light';for(var i=0;i<c.length;i++)c[i].setAttribute('data-mode',m);})();`

const fontSpecimens: FontSpecimen[] = [
	{
		descriptor: 'display',
		font: 'Hanken Grotesk',
		sampleClass: 'font-medium',
		samples: [
			{ text: 'The quick brown fox jumps over the lazy dog' },
			{ italic: true, text: 'The quick brown fox jumps over the lazy dog' },
		],
	},
	{
		descriptor: 'cjk',
		font: 'MiSans',
		sampleClass: 'font-medium',
		samples: [
			{ text: '打造生产级界面与 AI 原生产品' },
			{ text: '本番品質の UI と AI ネイティブなプロダクトをつくる' },
		],
	},
	{
		descriptor: 'accent',
		font: 'Fugaz One',
		sampleClass: 'font-fugaz-one text-highlight-strong',
		samples: [{ text: 'Xat' }],
	},
	{
		descriptor: 'mono',
		font: 'Calling Code',
		sampleClass: 'font-mono',
		samples: [{ text: 'const greeting = "Hello"' }],
	},
	{
		descriptor: 'serif',
		font: 'Source Han Serif',
		sampleClass: 'font-serif font-semibold',
		samples: [{ text: 'Building production-quality interfaces' }],
	},
]
---

<RootLayout>
	<Seo
		canonicalPath="/design"
		description={m.design.pageDescription}
		image={pageOgImageUrl('design')}
		locale={locale}
		slot="head"
		title={m.design.pageTitle}
	/>

	<section>
		<Container class="page-shell">
			<div class="space-y-8">
				<SiteHeader locale={locale} messages={m} showBack />

				<div class="flex flex-col space-y-24">
					<!-- Hero -->
					<div class="flex flex-col gap-1">
						<button
							class="
								relative inline-block size-8 cursor-pointer rounded-md border-0 bg-transparent p-0 transition-transform duration-150
								ease-out outline-none perspective-near
								focus-visible:ring-2 focus-visible:ring-ring/50
								active:scale-97
							"
							aria-label={m.design.flipMascot}
							aria-pressed="false"
							type="button"
							data-shiny-coin
						>
							<span
								class="relative block size-full transform-3d"
								data-shiny-coin-inner
							>
								<Image
									alt="shiny-imi"
									class="absolute inset-0 size-full backface-hidden"
									loading="eager"
									src={shinyImi}
								/>
								<Image
									alt="shiny-tf"
									class="absolute inset-0 size-full rotate-y-180 backface-hidden"
									loading="eager"
									src={shinyTf}
								/>
							</span>
						</button>
						<h1 class="inline-flex items-end text-3xl font-medium text-foreground">
							{m.design.eyebrow}
						</h1>
					</div>

					<!-- 1. Overview -->
					<section class="space-y-6">
						<h2 class="text-2xl font-medium text-foreground">{m.design.northStar.title}</h2>
						<p class="max-w-prose text-base/7 text-muted-foreground">
							{m.design.northStar.tagline}
						</p>
						<ul class="max-w-prose list-inside list-disc space-y-2 text-sm text-muted-foreground">
							{m.design.northStar.characteristics.map(item => (
								<li>{item}</li>
							))}
						</ul>
					</section>

					<!-- 2. Typography -->
					<section class="space-y-8">
						<h2 class="text-2xl font-medium text-foreground">{m.design.typography.title}</h2>

						<div class="space-y-4">
							<h3 class="text-lg font-medium text-foreground">{m.design.typography.scaleTitle}</h3>
							<ul class="divide-y divide-border rounded-xl border border-border">
								{typographyScaleOrder.map((role) => {
									const row = m.design.typography.scale[role]
									return (
										<li class="
											flex flex-col gap-1 px-5 py-3.5
											sm:flex-row sm:items-baseline sm:justify-between sm:gap-6
										"
										>
											<p class="text-sm font-medium text-foreground">{row.role}</p>
											<p class="
												font-mono text-xs text-muted-foreground
												sm:text-right
											"
											>{row.spec}</p>
										</li>
									)
								})}
							</ul>
						</div>

						<div class="space-y-4">
							<h3 class="text-lg font-medium text-foreground">{m.design.typography.specimensTitle}</h3>
							<ul class="space-y-3">
								{fontSpecimens.map(spec => (
									<li class="rounded-xl border border-border px-5 py-4">
										<p class="font-mono text-xs text-muted-foreground">
											{spec.font} — {m.design.typography.sampleDescriptors[spec.descriptor]}
										</p>
										<div class="mt-2 overflow-x-auto pb-1">
											{spec.samples.map(sample => (
												<p class={`
													text-2xl whitespace-nowrap
													${spec.sampleClass}
													${sample.italic ? 'italic' : ''}
												`}
												>
													{sample.text}
												</p>
											))}
										</div>
									</li>
								))}
							</ul>
						</div>
					</section>

					<!-- 3. Colors -->
					<section class="space-y-8">
						<div class="space-y-3">
							<h2 class="text-2xl font-medium text-foreground">{m.design.colors.title}</h2>
							<p class="max-w-prose text-base/7 text-muted-foreground">
								{m.design.colors.intro}
							</p>
						</div>

						<div class="space-y-12">
							{colorGroups.map((group) => {
								const groupCopy = m.design.colors.groups[group.key]
								return (
									<div class="space-y-5">
										<div class="space-y-1.5">
											<h3 class="text-lg font-medium text-foreground">{groupCopy.title}</h3>
											<p class="max-w-prose text-sm text-muted-foreground">{groupCopy.description}</p>
										</div>

										<div
											class="group/colorcard page-grid-2"
											data-mode="light"
											data-color-card
										>
											{(['light', 'dark'] as const).map((paneMode) => {
												const scopeClass = paneMode === 'light' ? 'theme-light' : 'theme-dark'
												const hiddenClass = paneMode === 'light'
													? '@max-lg/page:group-data-[mode=dark]/colorcard:hidden'
													: '@max-lg/page:group-data-[mode=light]/colorcard:hidden'
												return (
													<div
														class={`
															${scopeClass}
															${hiddenClass}
															overflow-hidden rounded-xl border border-border bg-background
														`}
														data-color-pane={paneMode}
													>
														<div
															class="
																flex items-center gap-2 border-b border-border px-5 py-2.5
																@lg/page:hidden
															"
															aria-label={m.design.colors.tablistLabel}
															role="group"
														>
															{(['light', 'dark'] as const).map((tabMode, idx) => (
																<>
																	{idx > 0 && (
																		<span aria-hidden="true" class="font-mono text-xs text-muted-foreground/40">·</span>
																	)}
																	<button
																		class="
																			cursor-pointer font-mono text-xs font-medium text-muted-foreground/70 transition-colors duration-150
																			hover:text-foreground
																			aria-pressed:text-foreground
																		"
																		aria-label={m.design.colors.modeLabel[tabMode]}
																		aria-pressed={tabMode === paneMode ? 'true' : 'false'}
																		data-color-tab={tabMode}
																		type="button"
																	>
																		.{tabMode}
																	</button>
																</>
															))}
														</div>
														<div class="
															hidden border-b border-border px-5 py-2.5
															@lg/page:block
														"
														>
															<p class="font-mono text-xs font-medium text-muted-foreground">.{paneMode}</p>
														</div>
														<ul class="divide-y divide-border">
															{group.tokens.map(token => (
																<li
																	class="flex items-center gap-4 px-5 py-3.5"
																	data-color-row={token.var}
																>
																	<span
																		aria-hidden="true"
																		class="size-11 shrink-0 rounded-md border border-border"
																		style={`background: var(${token.var})`}
																	/>
																	<div class="min-w-0 flex-1 space-y-0.5">
																		<p class="truncate text-sm font-medium text-foreground">{token.name}</p>
																		<p class="truncate text-xs text-muted-foreground">{m.design.colors.roles[token.role]}</p>
																		<code
																			class="block truncate font-mono text-[10.5px] text-muted-foreground/85 tabular-nums"
																			data-color-value
																		>
																			—
																		</code>
																	</div>
																</li>
															))}
														</ul>
													</div>
												)
											})}
										</div>
									</div>
								)
							})}
						</div>
						<script set:html={colorTabsBootstrap} is:inline />
					</section>

					<!-- 4. Elevation -->
					<section class="space-y-6">
						<div class="space-y-3">
							<h2 class="text-2xl font-medium text-foreground">{m.design.elevation.title}</h2>
							<p class="max-w-prose text-base/7 text-muted-foreground">{m.design.elevation.intro}</p>
							<p class="max-w-prose text-sm text-muted-foreground">{m.design.elevation.flatNote}</p>
						</div>
						<div class="rounded-xl border border-border bg-background px-5 py-6 shadow-halo">
							<p class="font-mono text-xs text-muted-foreground">shadow-halo</p>
							<p class="mt-3 text-sm text-foreground">0 1px 2px · highlight-soft / 30%</p>
						</div>
					</section>

					<!-- 5. Components -->
					<section class="space-y-8">
						<div class="space-y-3">
							<h2 class="text-2xl font-medium text-foreground">{m.design.components.title}</h2>
							<p class="max-w-prose text-base/7 text-muted-foreground">
								{m.design.components.intro}
							</p>
						</div>

						<div class="space-y-4">
							<div class="space-y-1.5">
								<h3 class="text-lg font-medium text-foreground">{m.design.components.primeTitle}</h3>
								<p class="max-w-prose text-sm text-muted-foreground">{m.design.components.primeIntro}</p>
							</div>
							<HomeCardLink
								description={m.design.components.cardDescription}
								href="https://ui.bejamas.com"
								title={m.design.components.cardTitle}
								external
							/>
						</div>

						<div class="space-y-4">
							<div class="space-y-1.5">
								<h3 class="text-lg font-medium text-foreground">{m.design.components.particlesTitle}</h3>
								<p class="max-w-prose text-sm text-muted-foreground">{m.design.components.particlesIntro}</p>
							</div>
							<ul class="page-grid-2">
								<ComponentPreviewCanvas
									contentClass="origin-bottom-right scale-[8.5]"
									descriptor={m.design.components.textLinkDescriptor}
									name="TextLink"
									stageClass="items-end justify-end p-8"
								>
									<TextLink class="whitespace-nowrap" decorative>{m.home.viewAllPosts}</TextLink>
								</ComponentPreviewCanvas>
								<ComponentPreviewCanvas
									descriptor={m.design.components.wandererDescriptor}
									name="Wanderer gradient"
									magnifierTour
								>
									<p
										class="wanderer-gradient-text relative z-0 text-4xl font-bold"
										data-wanderer-specimen
									>
										{m.wanderer.wanderer}
									</p>
								</ComponentPreviewCanvas>
								<ComponentPreviewCanvas
									contentClass="font-ui text-3xl tabular-nums"
									descriptor={m.design.components.statDigitsDescriptor}
									name="Stat digits"
								>
									<span
										class="site-stat-number align-baseline"
										data-design-stat-value="927"
										data-design-stat-digits-preview
									>
										<span class="site-stat-digit">9</span>
										<span class="site-stat-digit">2</span>
										<span class="site-stat-digit">7</span>
									</span>
								</ComponentPreviewCanvas>
							</ul>
						</div>
					</section>

					<!-- 6. Named rules -->
					<section class="space-y-6">
						<h2 class="text-2xl font-medium text-foreground">{m.design.principles.title}</h2>
						<ul class="space-y-4">
							{m.design.principles.rules.map(rule => (
								<li class="surface-callout px-5 py-4">
									<p class="text-sm font-semibold text-foreground">{rule.name}</p>
									<p class="mt-1 text-sm text-muted-foreground">{rule.body}</p>
								</li>
							))}
						</ul>
					</section>
				</div>
			</div>
		</Container>
	</section>
</RootLayout>

<script>
import { animate } from 'motion'

import { onAstroPageLoad } from '@/client/astro-page-lifecycle'

const FLIP_DURATION_S = 0.7
const FLIP_EASE: [number, number, number, number] = [0.77, 0, 0.175, 1]

onAstroPageLoad(() => {
	const rows = document.querySelectorAll<HTMLElement>('[data-color-row]')
	rows.forEach((row) => {
		const varName = row.dataset.colorRow
		if (!varName)
			return
		const value = getComputedStyle(row).getPropertyValue(varName).trim()
		const target = row.querySelector<HTMLElement>('[data-color-value]')
		if (target && value)
			target.textContent = value
	})

	const initialMode = document.documentElement.classList.contains('dark') ? 'dark' : 'light'
	const cards = document.querySelectorAll<HTMLElement>('[data-color-card]')
	cards.forEach((card) => {
		card.setAttribute('data-mode', initialMode)

		const tabs = card.querySelectorAll<HTMLButtonElement>('[data-color-tab]')
		tabs.forEach((tab) => {
			tab.addEventListener('click', () => {
				const mode = tab.dataset.colorTab
				if (!mode)
					return
				card.setAttribute('data-mode', mode)
				const targetPane = card.querySelector<HTMLElement>(`[data-color-pane="${mode}"]`)
				const focusTarget = targetPane?.querySelector<HTMLButtonElement>(`[data-color-tab="${mode}"]`)
				if (focusTarget && focusTarget !== tab)
					focusTarget.focus()
			})
		})
	})

	const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)')
	const coins = document.querySelectorAll<HTMLButtonElement>('[data-shiny-coin]')
	for (const button of coins) {
		const inner = button.querySelector<HTMLElement>('[data-shiny-coin-inner]')
		if (!inner)
			continue

		let rotation = 0
		let isFlipping = false

		button.addEventListener('click', () => {
			if (isFlipping)
				return

			const from = rotation
			const to = rotation + 180
			rotation = to
			button.setAttribute('aria-pressed', String((to / 180) % 2 === 1))

			if (reducedMotion.matches) {
				inner.style.transform = `rotateY(${to}deg)`
				return
			}

			isFlipping = true
			animate(
				inner,
				{
					rotateY: [from, to],
					scale: [1, 1.4, 1],
					y: [0, -6, 0],
				},
				{
					duration: FLIP_DURATION_S,
					ease: FLIP_EASE,
				},
			).finished.finally(() => {
				isFlipping = false
			})
		})
	}
})
</script>
