---
import type { Locale } from '@/lib/i18n/constants'

import { render } from 'astro:content'

import MiSansContentFont from '@/components/fonts/mi-sans-content-font.astro'
import Container from '@/components/layout/container.astro'
import Eyebrow from '@/components/layout/eyebrow.astro'
import SiteHeader from '@/components/layout/site-header.astro'
import Seo from '@/components/meta/seo.astro'
import StaggerReveal from '@/components/motion/stagger-reveal.astro'
import ArticleBody from '@/components/post/article-body.astro'
import PostIndexRow from '@/components/post/post-index-row.astro'
import PostTranslatedNoticeAside from '@/components/post/post-translated-notice-aside.astro'
import RootLayout from '@/layouts/root-layout.astro'
import { formatPostDate, formatPostMonth, getAllPosts, getCategoryBySlug, getPostBySlug } from '@/lib/blog'
import { getMessages } from '@/lib/i18n/messages'
import { mdxComponents } from '@/lib/mdx-components'
import { articleBreadcrumbJsonLd, blogPostingJsonLd, postOgImageUrl, SITE_NAME } from '@/lib/seo-data'
import { postCardTransitionName } from '@/lib/view-transition'
import { toTranslator } from '@/types/translator'

export const prerender = false

const { slug } = Astro.params as { slug: string }
const locale = (Astro.locals.locale ?? 'en') as Locale
const m = getMessages(locale)
const post = await getPostBySlug(slug, locale)

if (!post) {
	return Astro.rewrite('/404')
}

const category = await getCategoryBySlug(post.category)
const localizedCategory = category
	? m.categories[category.slug as keyof typeof m.categories]
	: undefined
const categoryEyebrow = localizedCategory ? localizedCategory.name : post.category
const canonicalPath = `/post/${post.slug}`
const articleSection = localizedCategory?.name
const seoDescription = post.seoDescription ?? post.summary
const translator = toTranslator(post.translator)

const { Content, headings } = await render(post.entry)
const sections = headings.filter(heading => heading.depth === 2)

// Posts are newest first, so the newer neighbor sits before this one.
const allPosts = await getAllPosts(locale)
const index = allPosts.findIndex(entry => entry.slug === post.slug)
const neighbors = [
	{ label: m.blog.newer, post: allPosts[index - 1] },
	{ label: m.blog.older, post: allPosts[index + 1] },
].flatMap(({ label, post: entry }) => (entry ? [{ label, post: entry }] : []))
---

<RootLayout>
	<Seo
		jsonLd={[
			blogPostingJsonLd({
				articleSection,
				canonicalPath,
				date: post.date,
				description: seoDescription,
				image: postOgImageUrl(slug),
				locale,
				tags: post.tags,
				title: post.title,
			}),
			articleBreadcrumbJsonLd([
				{ name: SITE_NAME, path: '/' },
				{ name: m.blog.title, path: '/post' },
				{ name: post.title, path: canonicalPath },
			]),
		]}
		canonicalPath={canonicalPath}
		description={seoDescription}
		image={postOgImageUrl(slug)}
		imageAlt={`${post.title} - Xat`}
		locale={locale}
		slot="head"
		title={`${post.title} - Xat`}
		type="article"
	/>

	<section>
		<MiSansContentFont />
		<Container class="page-shell">
			<StaggerReveal class="flex flex-col space-y-8">
				<div class="space-y-8" data-post-card-vt="target" transition:name={postCardTransitionName(post.slug)}>
					<SiteHeader locale={locale} messages={m} showBack />
					<div class="space-y-3">
						<Eyebrow>{categoryEyebrow}</Eyebrow>
						<h1 class="text-3xl font-medium text-foreground">{post.title}</h1>
						<p class="text-base/7 text-muted-foreground">{post.summary}</p>
					</div>
					<div class="font-ui text-sm text-muted-foreground">
						<span>{formatPostDate(post.date, locale)}</span>
					</div>
					{sections.length >= 3 && (
						<nav aria-label={m.blog.toc} class="font-ui text-sm">
							<ol class="space-y-1.5">
								{sections.map((section, i) => (
									<li class="flex items-baseline gap-3">
										<span class="font-mono text-xs text-muted-foreground/70 tabular-nums">{String(i + 1).padStart(2, '0')}</span>
										<a
											class="
												text-muted-foreground transition-colors duration-150
												hover:text-foreground
											"
											href={`#${section.slug}`}
										>
											{section.text}
										</a>
									</li>
								))}
							</ol>
						</nav>
					)}
					{m.blog.postTranslatedNotice && (
						<PostTranslatedNoticeAside notice={m.blog.postTranslatedNotice} translator={translator} />
					)}
				</div>

				<ArticleBody>
					<Content components={mdxComponents} />
				</ArticleBody>

				<nav aria-label={m.blog.moreWriting} class="mt-8 space-y-4">
					<div class="flex items-baseline justify-between gap-6">
						<Eyebrow as="h2" class="font-semibold">{m.blog.moreWriting}</Eyebrow>
						<a class="text-link font-ui text-sm" href="/post" data-astro-prefetch>
							{m.home.viewAllPosts}
						</a>
					</div>
					<ul class="divide-y divide-border border-y border-border">
						{neighbors.map(({ label, post: neighbor }) => (
							<PostIndexRow
								dateLabel={formatPostMonth(neighbor.date)}
								href={`/post/${neighbor.slug}`}
								meta={label}
								slug={neighbor.slug}
								summary={neighbor.summary}
								title={neighbor.title}
							/>
						))}
					</ul>
				</nav>
			</StaggerReveal>
		</Container>
	</section>
</RootLayout>
