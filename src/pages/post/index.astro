---
import type { Locale } from '@/lib/i18n/constants'

import HomeCardLink from '@/components/home-card-link.astro'
import MiSansContentFont from '@/components/mi-sans-content-font.astro'
import Reveal from '@/components/reveal.astro'
import Seo from '@/components/seo.astro'
import SiteHeader from '@/components/site-header.astro'
import StaggerReveal from '@/components/stagger-reveal.astro'
import Container from '@/components/ui/container.astro'
import Eyebrow from '@/components/ui/eyebrow.astro'
import RootLayout from '@/layouts/root-layout.astro'
import { getPostsByCategory } from '@/lib/blog'
import { cn } from '@/lib/cn'
import { getMessages } from '@/lib/i18n/messages'

const locale = (Astro.locals.locale ?? 'en') as Locale
const m = getMessages(locale)
const rawGroups = await getPostsByCategory(locale)
const groups = rawGroups.map((group) => {
	const cat = m.categories[group.category.slug as keyof typeof m.categories]
	return {
		category: cat ? { ...group.category, description: cat.description, name: cat.name } : group.category,
		posts: group.posts,
	}
})
---

<RootLayout>
	<Seo
		canonicalPath="/post"
		description={m.blog.pageDescription}
		locale={locale}
		slot="head"
		title={m.blog.pageTitle}
	/>

	<section>
		<MiSansContentFont />
		<Container class="page-shell">
			<StaggerReveal class="flex flex-col">
				<div class="space-y-8">
					<SiteHeader locale={locale} messages={m} showBack />
					<div class="space-y-0">
						<h1 class="font-medium text-foreground">{m.blog.title}</h1>
						<p class="text-muted-foreground">{m.blog.archiveSubtitle}</p>
					</div>
				</div>

				{groups.map((group, index) => (
					<section class={cn('space-y-7', index === 0
						? `
							mt-28
							md:mt-32
						`
						: 'mt-20')}
					>
						<Reveal staggerIndex={0}>
							<div>
								<Eyebrow>{group.category.name}</Eyebrow>
								<p class="mt-1 text-base/6 text-muted-foreground">{group.category.description}</p>
							</div>
						</Reveal>

						<div class="space-y-3">
							{group.posts.map((post, postIndex) => (
								<Reveal staggerIndex={postIndex + 1}>
									<HomeCardLink
										description={post.summary}
										href={`/post/${post.slug}`}
										title={post.title}
										prefetchOnView
									/>
								</Reveal>
							))}
						</div>
					</section>
				))}
			</StaggerReveal>
		</Container>
	</section>
</RootLayout>
