---
import type { Locale } from '@/lib/i18n/constants'

import Dot from '~icons/lucide/dot'

import MiSansContentFont from '@/components/fonts/mi-sans-content-font.astro'
import Container from '@/components/layout/container.astro'
import SiteHeader from '@/components/layout/site-header.astro'
import Seo from '@/components/meta/seo.astro'
import Reveal from '@/components/motion/reveal.astro'
import StaggerReveal from '@/components/motion/stagger-reveal.astro'
import PostIndexRow from '@/components/post/post-index-row.astro'
import RootLayout from '@/layouts/root-layout.astro'
import { formatPostMonthDay, getPostsByYear } from '@/lib/blog'
import { getMessages } from '@/lib/i18n/messages'
import { RSS_FEED_URL, RSS_FEED_URL_EN, RSS_FEED_URL_JA } from '@/lib/rss'
import { pageOgImageUrl } from '@/lib/seo-data'

const locale = (Astro.locals.locale ?? 'en') as Locale
const m = getMessages(locale)
const yearGroups = await getPostsByYear(locale)
const totalPosts = yearGroups.reduce((sum, group) => sum + group.posts.length, 0)
const feedUrl = { en: RSS_FEED_URL_EN, ja: RSS_FEED_URL_JA, zh: RSS_FEED_URL }[locale]
---

<RootLayout>
	<Seo
		canonicalPath="/post"
		description={m.blog.pageDescription}
		image={pageOgImageUrl('post')}
		locale={locale}
		slot="head"
		title={m.blog.pageTitle}
	/>

	<section>
		<MiSansContentFont />
		<Container class="page-shell">
			<StaggerReveal class="flex flex-col">
				<div class="space-y-8">
					<SiteHeader locale={locale} messages={m} showBack />
					<div class="flex items-baseline justify-between gap-4">
						<h1 class="text-3xl font-medium text-foreground">{m.blog.title}</h1>
						<span class="flex items-baseline gap-2 font-ui text-sm text-muted-foreground">
							<span><span class="font-mono text-xs tabular-nums">{totalPosts}</span>{m.blog.postCountSuffix}</span>
							<Dot aria-hidden="true" class="size-3 shrink-0 self-center opacity-70" />
							<a class="text-link-muted" href={feedUrl} type="application/rss+xml">RSS</a>
						</span>
					</div>
				</div>

				<div class="mt-14 space-y-12">
					{yearGroups.map((group, index) => (
						<section class="space-y-3">
							<Reveal staggerIndex={index}>
								<h2 class="font-mono text-xs text-muted-foreground tabular-nums">{group.year}</h2>
								<ul class="mt-3 divide-y divide-border border-y border-border">
									{group.posts.map((post) => {
										const category = m.categories[post.category as keyof typeof m.categories]?.name ?? post.category
										return (
											<PostIndexRow
												dateLabel={formatPostMonthDay(post.date)}
												href={`/post/${post.slug}`}
												meta={category}
												slug={post.slug}
												summary={post.summary}
												title={post.title}
												prefetchOnView
											/>
										)
									})}
								</ul>
							</Reveal>
						</section>
					))}
				</div>
			</StaggerReveal>
		</Container>
	</section>
</RootLayout>
