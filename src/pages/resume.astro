---
import type { Locale } from '@/lib/i18n/constants'

import { getEntry } from 'astro:content'
import Dot from '~icons/lucide/dot'

import Container from '@/components/layout/container.astro'
import Eyebrow from '@/components/layout/eyebrow.astro'
import SiteHeader from '@/components/layout/site-header.astro'
import Seo from '@/components/meta/seo.astro'
import StaggerReveal from '@/components/motion/stagger-reveal.astro'
import TechList from '@/components/resume/tech-list.astro'
import RootLayout from '@/layouts/root-layout.astro'
import { getMessages } from '@/lib/i18n/messages'
import { pageOgImageUrl, personJsonLd } from '@/lib/seo-data'

const locale = (Astro.locals.locale ?? 'en') as Locale
const m = getMessages(locale)
const entry = await getEntry('resume', locale)
if (!entry)
	throw new Error(`Missing content/resume/${locale}.yaml`)
const { contact, education, experience, openSource, projects, role, skills, summary } = entry.data

/** `2024-05` → `2024·05`, the index-row date style. */
const month = (value: string) => value.replace('-', '·')
function period(start: string, end?: string) {
	if (start === end)
		return month(start)
	return `${month(start)} – ${end ? month(end) : m.resume.present}`
}

// Every row hangs off one rail (dates, or a label for skills and education); below the full column width it stacks.
const rowLayout = `
	flex flex-col gap-1 py-3.5
	print:py-1.5
	@lg/page:grid @lg/page:grid-cols-[7rem_minmax(0,1fr)] @lg/page:items-baseline @lg/page:gap-x-6
`
// `resume-row` keeps a row on one page; a project is too tall for that and breaks between its bullets instead.
const rowClass = `resume-row ${rowLayout}`
const linkRowClass = `
	group/row transition-colors
	focus-visible:rounded-sm
	${rowClass}
`
// Linked rows stack title over summary on screen; on paper they run inline to save a line each.
const linkBodyClass = `
	min-w-0 space-y-1
	print:space-y-0
`
const linkTitleClass = `
	block text-sm font-medium text-foreground transition-colors duration-150
	group-hover/row:text-highlight-strong
	print:mr-2 print:inline
`
const linkSummaryClass = `
	block text-sm/6 text-muted-foreground
	print:inline
`
const sectionClass = `
	mt-14 space-y-4
	print:mt-6 print:space-y-2.5
`
const railClass = 'font-mono text-xs text-muted-foreground tabular-nums'
const listClass = 'divide-y divide-border border-y border-border'
---

<RootLayout>
	<Seo
		canonicalPath="/resume"
		description={m.resume.pageDescription}
		image={pageOgImageUrl('resume')}
		jsonLd={personJsonLd({ description: m.resume.pageDescription })}
		locale={locale}
		slot="head"
		title={m.resume.pageTitle}
		type="profile"
	>
		<link as="font" crossorigin="anonymous" href="/fonts/fugaz-one-regular-subset.woff2" rel="preload" type="font/woff2" />
	</Seo>

	<section data-resume>
		<Container class="page-shell">
			<StaggerReveal class="flex flex-col">
				<div class="print:hidden">
					<SiteHeader locale={locale} messages={m} showBack />
				</div>

				<header class="
					mt-8 space-y-4
					print:mt-0
				"
				>
					<div class="flex items-end justify-between gap-6">
						<div>
							<h1 class="font-fugaz-one text-3xl font-normal text-highlight-brand">Xat</h1>
							<p class="mt-1 text-muted-foreground">{role}</p>
						</div>
						<button
							class="
								text-link shrink-0 font-ui text-sm whitespace-nowrap
								print:hidden
							"
							type="button"
							data-resume-print
						>
							{m.resume.print}
						</button>
					</div>
					<ul class="flex flex-wrap items-center gap-x-2 gap-y-1 font-ui text-sm">
						{contact.map((item, index) => (
							<li class="flex items-center gap-2">
								{index > 0 && <Dot aria-hidden="true" class="size-3 shrink-0 text-muted-foreground opacity-70" />}
								<a
									class="text-link"
									href={item.href}
									rel={item.href.startsWith('mailto:') ? undefined : 'noreferrer'}
									target={item.href.startsWith('mailto:') ? undefined : '_blank'}
								>
									{item.label}
								</a>
							</li>
						))}
					</ul>
					<p class="
						max-w-prose text-base/7 text-foreground
						print:max-w-none print:leading-6
					"
					>
						{summary}
					</p>
				</header>

				<section class={sectionClass}>
					<Eyebrow as="h2" class="font-semibold">{m.resume.sections.experience}</Eyebrow>
					{experience.map(job => (
						<div class="space-y-3">
							<div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
								<h3 class="text-sm font-medium text-foreground">
									{job.organization}<span class="text-muted-foreground"> · {job.role}</span>
								</h3>
								<span class={railClass}>{period(job.start, job.end)}</span>
							</div>
							<p class="text-sm/6 text-muted-foreground">{job.summary}</p>
							<ul class={listClass}>
								{job.projects.map(project => (
									<li class={rowLayout}>
										<span class={railClass}>{period(project.start, project.end)}</span>
										<div class="min-w-0 space-y-1.5">
											<h4 class="text-sm font-medium text-foreground">{project.name}</h4>
											{project.summary && <p class="text-sm/6 text-muted-foreground">{project.summary}</p>}
											<ul class="
												list-disc space-y-1 pl-4 text-sm/6 text-foreground
												marker:text-muted-foreground
											"
											>
												{project.highlights.map(highlight => <li>{highlight}</li>)}
											</ul>
											<TechList class="font-mono text-xs text-muted-foreground" items={project.stack} />
										</div>
									</li>
								))}
							</ul>
						</div>
					))}
				</section>

				<section class={sectionClass}>
					<Eyebrow as="h2" class="font-semibold">{m.resume.sections.openSource}</Eyebrow>
					<ul class={listClass}>
						{openSource.map(item => (
							<li>
								<a class={linkRowClass} href={item.href} rel="noreferrer" target="_blank">
									<span class={railClass}>{month(item.date)}</span>
									<span class={linkBodyClass}>
										<span class={linkTitleClass}>{item.project}</span>
										<span class={linkSummaryClass}>{item.summary}</span>
									</span>
								</a>
							</li>
						))}
					</ul>
				</section>

				<section class={sectionClass}>
					<Eyebrow as="h2" class="font-semibold">{m.resume.sections.projects}</Eyebrow>
					<ul class={listClass}>
						{projects.map(item => (
							<li>
								<a class={linkRowClass} href={item.href} rel="noreferrer" target="_blank">
									<span class={railClass}>{month(item.date)}</span>
									<span class={linkBodyClass}>
										<span class={linkTitleClass}>{item.name}</span>
										<span class={linkSummaryClass}>{item.summary}</span>
									</span>
								</a>
							</li>
						))}
					</ul>
				</section>

				<section class={sectionClass}>
					<Eyebrow as="h2" class="font-semibold">{m.resume.sections.skills}</Eyebrow>
					<ul class={listClass}>
						{skills.map(skill => (
							<li class={rowClass}>
								<span class="text-xs text-muted-foreground">{skill.group}</span>
								<TechList class="text-sm/6 text-foreground" items={skill.items} />
							</li>
						))}
					</ul>
				</section>

				<section class={sectionClass}>
					<Eyebrow as="h2" class="font-semibold">{m.resume.sections.education}</Eyebrow>
					<ul class={listClass}>
						{education.map(item => (
							<li class={rowClass}>
								<span class="text-xs text-muted-foreground">{item.degree}</span>
								<span class="text-sm/6 text-foreground">{item.school ? `${item.major} · ${item.school}` : item.major}</span>
							</li>
						))}
					</ul>
				</section>
			</StaggerReveal>
		</Container>
	</section>
</RootLayout>

<script>
// Delegated once at module load, so it survives ClientRouter swaps without re-binding.
document.addEventListener('click', (event) => {
	if (event.target instanceof Element && event.target.closest('[data-resume-print]'))
		window.print()
})
</script>

<style is:global>
	/*
	 * A4 print: paper is always light, so the tokens the resume reads are pinned to
	 * their light values whatever theme is on screen; the site chrome drops out and
	 * the column takes the full printable width at a smaller root size.
	 */
	@media print {
		@page {
			size: A4;
			margin: 10mm 14mm;
		}

		:root:has([data-resume]) {
			color-scheme: light;
			font-size: 12px;
			--background: oklch(1 0 0);
			--foreground: oklch(0.17 0.003 260);
			--muted-foreground: oklch(0.45 0.004 260);
			--border: oklch(0 0 0 / 0.12);
			--highlight-brand: oklch(0.673 0.117 3);
			--highlight-text: oklch(0.56 0.13 3);
		}

		:root:has([data-resume]) body {
			min-height: 0;
			font-size: 1rem;
		}

		:root:has([data-resume]) :is(body > div, main) {
			min-height: 0;
			padding-top: 0;
		}

		:root:has([data-resume]) :is(footer, .custom-scrollbar) {
			display: none;
		}

		[data-resume] .page-shell {
			max-width: none;
			padding: 0;
		}

		/* Reveals wait for scroll; paper shows everything at rest. */
		[data-resume] :is([data-reveal], [data-stagger-reveal] > *) {
			opacity: 1 !important;
			filter: none !important;
			transform: none !important;
		}

		[data-resume] a {
			color: inherit;
			background-image: none;
		}

		/* Paper reads denser than a screen: one tighter rhythm for every line of copy. */
		[data-resume] :is(p, li, span) {
			line-height: 1.55;
		}

		[data-resume] :is(header, .resume-row, li li) {
			break-inside: avoid;
		}

		[data-resume] :is(h2, h3, h4) {
			break-after: avoid;
		}
	}
</style>
