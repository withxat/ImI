---
import type { Locale } from '@/lib/i18n/constants'

import { getEntry } from 'astro:content'
import List from 'kubai-icons/duotone/icons/list'
import Printer from 'kubai-icons/duotone/icons/printer'
import ArrowUpRight from '~icons/local/arrow-up-right'
import Dot from '~icons/lucide/dot'

import KubaiIcon from '@/components/icons/kubai-icon.astro'
import Container from '@/components/layout/container.astro'
import EmailCopyLink from '@/components/layout/email-copy-link.astro'
import Eyebrow from '@/components/layout/eyebrow.astro'
import SiteHeader from '@/components/layout/site-header.astro'
import Seo from '@/components/meta/seo.astro'
import StaggerReveal from '@/components/motion/stagger-reveal.astro'
import TechList from '@/components/resume/tech-list.astro'
import RootLayout from '@/layouts/root-layout.astro'
import { getMessages } from '@/lib/i18n/messages'
import { pageOgImageUrl, personJsonLd } from '@/lib/seo-data'

const locale = (Astro.locals.locale ?? 'en') as Locale
const m = getMessages(locale)
const entry = await getEntry('resume', locale)
if (!entry)
	throw new Error(`Missing content/resume/${locale}.yaml`)
const { contact, education, experience, openSource, projects, role, skills, summary } = entry.data
const featuredOpenSource = openSource.filter(item => !item.webOnly)
const moreOpenSource = openSource.filter(item => item.webOnly)

const resumeSections = [
	{ id: 'experience', label: m.resume.sections.experience },
	{ id: 'open-source', label: m.resume.sections.openSource },
	{ id: 'projects', label: m.resume.sections.projects },
	{ id: 'skills', label: m.resume.sections.skills },
	{ id: 'education', label: m.resume.sections.education },
]

/** `2024-05` → `2024·05`, the index-row date style. */
const month = (value: string) => value.replace('-', '·')
function period(start: string, end?: string) {
	if (start === end)
		return month(start)
	return `${month(start)} – ${end ? month(end) : m.resume.present}`
}

/**
 * Splits a concise topic lead from a highlight bullet for screen scanning, while print stays uniform ink.
 * zh uses `：`, ja uses the first short `。`, and en uses the first short `. ` sentence.
 */
function splitHighlightLead(text: string, lang: Locale): { lead?: string, rest: string } {
	if (lang === 'zh') {
		const idx = text.indexOf('：')
		if (idx > 0 && idx <= 18 && !/[，。（）()]/.test(text.slice(0, idx)))
			return { lead: text.slice(0, idx + 1), rest: text.slice(idx + 1) }
		return { rest: text }
	}
	if (lang === 'ja') {
		const idx = text.indexOf('。')
		if (idx > 0 && idx <= 20 && idx < text.length - 1 && !/[、（()）]/.test(text.slice(0, idx)))
			return { lead: text.slice(0, idx + 1), rest: text.slice(idx + 1) }
		return { rest: text }
	}
	const idx = text.indexOf('. ')
	if (idx > 0 && idx <= 40 && idx < text.length - 2 && !/[,()]/.test(text.slice(0, idx)))
		return { lead: text.slice(0, idx + 1), rest: text.slice(idx + 1) }
	return { rest: text }
}

// Experience projects use full column width on screen for comfortable reading, and return to the
// tight 7rem date-rail grid on paper so A4 fits cleanly.
const projectRowClass = `
	py-6 first:pt-5
	print:grid print:grid-cols-[7rem_minmax(0,1fr)] print:items-baseline print:gap-x-6 print:py-1.5 print:first:pt-1.5
`
const linkRowClass = `
	resume-row group/row flex flex-col gap-1.5 py-4 transition-colors
	focus-visible:rounded-sm
	@lg/page:grid @lg/page:grid-cols-[5.5rem_minmax(0,1fr)_auto] @lg/page:items-baseline @lg/page:gap-x-6
	print:grid print:grid-cols-[7rem_minmax(0,1fr)] print:items-baseline print:gap-x-6 print:py-1.5
`
const labelRowClass = `
	resume-row flex flex-col gap-2 py-4
	@lg/page:grid @lg/page:grid-cols-[8.5rem_minmax(0,1fr)] @lg/page:items-baseline @lg/page:gap-x-6
	print:grid print:grid-cols-[7rem_minmax(0,1fr)] print:items-baseline print:gap-x-6 print:gap-y-1 print:py-1.5
`
// Linked rows stack title over summary on screen; on paper they run inline to save a line each.
const linkBodyClass = `
	min-w-0 space-y-1.5
	print:space-y-0
`
const linkTitleClass = `
	block text-sm font-medium text-foreground transition-colors duration-150
	group-hover/row:text-highlight-strong
	print:mr-2 print:inline
`
const linkSummaryClass = `
	block text-sm/6 text-muted-foreground
	print:inline
`
const linkArrowClass = `
	hidden size-3.5 shrink-0 text-muted-foreground/70 transition-transform duration-150 ease-out
	group-hover/row:translate-x-0.5 group-hover/row:-translate-y-0.5 group-hover/row:text-highlight-strong
	motion-reduce:transition-none
	@lg/page:block
	print:hidden
`
const sectionClass = `
	mt-16 space-y-5
	print:mt-6 print:space-y-2.5
`
const headingClass = `
	scroll-mt-8 font-semibold
	focus:outline-none
`
const railClass = 'font-mono text-xs text-muted-foreground tabular-nums'
const listClass = 'divide-y divide-border border-y border-border'
---

<RootLayout>
	<Seo
		canonicalPath="/resume"
		description={m.resume.pageDescription}
		image={pageOgImageUrl('resume', locale)}
		jsonLd={personJsonLd({ description: m.resume.pageDescription })}
		locale={locale}
		markdownPath="/resume.md"
		slot="head"
		title={m.resume.pageTitle}
		type="profile"
	>
		<link as="font" crossorigin="anonymous" href="/fonts/fugaz-one-regular-subset.woff2" rel="preload" type="font/woff2" />
	</Seo>

	<section data-resume>
		<Container class="page-shell">
			<div class="flex flex-col">
				<SiteHeader locale={locale} messages={m} showBack />
				<StaggerReveal class="flex flex-col">
					<header
						class="
							mt-8 space-y-4
							print:mt-0
						"
					>
						<div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-3">
							<div>
								<h1 class="font-fugaz-one text-3xl font-normal text-highlight-brand">Xat</h1>
								<p class="mt-1 text-muted-foreground">{role}</p>
							</div>
							<div
								class="
									flex items-center gap-2 font-ui text-sm
									print:hidden
								"
							>
								<button
									class="
										inline-flex shrink-0 cursor-pointer items-center gap-1.5 rounded-full bg-muted px-2.5 py-1.5 text-xs
										text-muted-foreground transition-colors duration-150
										hover:bg-highlight-soft/25 hover:text-highlight-strong
										aria-expanded:bg-highlight-soft/25 aria-expanded:text-foreground
										dark:hover:bg-foreground/10
										dark:aria-expanded:bg-foreground/10
									"
									aria-controls="resume-sections"
									aria-expanded="false"
									type="button"
									data-section-outline-trigger
								>
									<KubaiIcon class="size-3.5 shrink-0 opacity-75" icon={List} />
									<span>{m.blog.sectionCount(resumeSections.length)}</span>
								</button>
								<button
									class="
										inline-flex shrink-0 cursor-pointer items-center gap-1.5 rounded-full highlight-surface highlight-surface-hover bg-popover px-3
										py-1.5 font-ui text-xs font-medium whitespace-nowrap text-foreground transition-[border-color,box-shadow,color] duration-150
										hover:text-highlight-strong
									"
									type="button"
									data-resume-print
								>
									<KubaiIcon class="size-3.5 text-muted-foreground" icon={Printer} />
									<span>{m.resume.print}</span>
								</button>
							</div>
						</div>
						<nav
							class="
								font-ui text-sm
								print:hidden
							"
							aria-label={m.blog.toc}
							id="resume-sections"
							hidden
						>
							<ol class="flex flex-wrap gap-x-4 gap-y-1.5">
								{resumeSections.map(section => (
									<li>
										<a
											class="
												text-muted-foreground transition-colors duration-150
												hover:text-foreground
											"
											href={`#${section.id}`}
										>
											{section.label}
										</a>
									</li>
								))}
							</ol>
						</nav>
						<ul class="flex flex-wrap items-center gap-x-2 gap-y-1 font-ui text-sm">
							{contact.map((item, index) => (
								<li class="flex items-center gap-2">
									{index > 0 && <Dot aria-hidden="true" class="size-3 shrink-0 text-muted-foreground opacity-70" />}
									{item.href.startsWith('mailto:')
										? (
												<EmailCopyLink
													address={item.href.slice('mailto:'.length)}
													copiedLabel={m.footer.emailCopied}
													copyLabel={m.footer.copyEmail}
													label={item.label}
												/>
											)
										: (
												<a
													class="text-link"
													href={item.href}
													rel="noreferrer"
													target="_blank"
												>
													{item.label}
												</a>
											)}
								</li>
							))}
						</ul>
						<p
							class="
								max-w-prose text-base/7 text-foreground
								print:max-w-none print:leading-6
							"
						>
							{summary}
						</p>
					</header>

					<section class={sectionClass}>
						<Eyebrow as="h2" class={headingClass} id="experience" tabindex="-1">{m.resume.sections.experience}</Eyebrow>
						{experience.map(job => (
							<div
								class="
									space-y-4
									print:space-y-3
								"
							>
								<div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
									<h3
										class="
											text-base font-medium text-foreground
											print:text-sm
										"
									>
										{job.organization}<span class="font-normal text-muted-foreground"> · {job.role}</span>
									</h3>
									<span class={railClass}>{period(job.start, job.end)}</span>
								</div>
								<p
									class="
										text-sm/6.5 text-muted-foreground
										print:text-sm/6
									"
								>
									{job.summary}
								</p>
								<ul class={listClass}>
									{job.projects.map(project => (
										<li class={projectRowClass}>
											<span class={`
												hidden
												print:block
												${railClass}
											`}
											>{period(project.start, project.end)}</span>
											<div
												class="
													min-w-0 space-y-2.5
													print:space-y-1.5
												"
											>
												<div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
													<h4
														class="
															text-[15px] font-medium text-foreground
															print:text-sm
														"
													>
														{project.name}
													</h4>
													<span class={`
														print:hidden
														${railClass}
													`}
													>{period(project.start, project.end)}</span>
												</div>
												{project.summary && (
													<p
														class="
															text-sm/6.5 text-muted-foreground
															print:text-sm/6
														"
													>
														{project.summary}
													</p>
												)}
												<ul
													class="
														list-disc space-y-2 pl-4 text-sm/6.5 text-foreground/85
														marker:text-muted-foreground/70
														print:space-y-1 print:text-sm/6 print:text-foreground
														print:marker:text-muted-foreground
													"
												>
													{project.highlights.map((highlight) => {
														const { lead, rest } = splitHighlightLead(highlight, locale)
														return (
															<li>
																{lead && (
																	<span
																		class="
																			font-medium text-foreground
																			print:font-normal
																		"
																	>
																		{lead}
																	</span>
																)}
																{rest}
															</li>
														)
													})}
												</ul>
												<TechList
													class="
														pt-1 font-mono text-xs text-muted-foreground
														print:pt-0
													"
													items={project.stack}
													variant="chips"
												/>
											</div>
										</li>
									))}
								</ul>
							</div>
						))}
					</section>

					<section class={sectionClass}>
						<Eyebrow as="h2" class={headingClass} id="open-source" tabindex="-1">{m.resume.sections.openSource}</Eyebrow>
						<ul class={listClass}>
							{featuredOpenSource.map(item => (
								<li>
									<a class={linkRowClass} href={item.href} rel="noreferrer" target="_blank">
										<span class={railClass}>{month(item.date)}</span>
										<span class={linkBodyClass}>
											<span class={linkTitleClass}>{item.project}</span>
											<span class={linkSummaryClass}>{item.summary}</span>
										</span>
										<ArrowUpRight aria-hidden="true" class={linkArrowClass} />
									</a>
								</li>
							))}
						</ul>
						{moreOpenSource.length > 0 && (
							<div
								class="
									space-y-2.5 pt-2
									print:hidden
								"
							>
								<p class="font-ui text-xs text-muted-foreground">
									{m.resume.moreOpenSource(moreOpenSource.length)}
								</p>
								<ul
									class="
										grid grid-cols-1 border-t border-border
										@lg/page:grid-cols-2 @lg/page:gap-x-8
									"
								>
									{moreOpenSource.map(item => (
										<li class="border-b border-border">
											<a
												class="
													group/more flex h-full flex-col gap-1 py-3 transition-colors
													focus-visible:rounded-sm
												"
												href={item.href}
												rel="noreferrer"
												target="_blank"
											>
												<span class="flex items-baseline justify-between gap-2">
													<span
														class="
															min-w-0 truncate text-sm font-medium text-foreground transition-colors duration-150
															group-hover/more:text-highlight-strong
														"
														title={item.project}
													>
														{item.project}
													</span>
													<span class="inline-flex shrink-0 items-center gap-1 font-mono text-xs text-muted-foreground tabular-nums">
														<span>{month(item.date)}</span>
														<ArrowUpRight
															class="
																size-3 shrink-0 text-muted-foreground/70 transition-transform duration-150 ease-out
																group-hover/more:translate-x-0.5 group-hover/more:-translate-y-0.5 group-hover/more:text-highlight-strong
																motion-reduce:transition-none
															"
															aria-hidden="true"
														/>
													</span>
												</span>
												<span class="text-xs/5 text-muted-foreground">{item.summary}</span>
											</a>
										</li>
									))}
								</ul>
							</div>
						)}
					</section>

					<section class={sectionClass}>
						<Eyebrow as="h2" class={headingClass} id="projects" tabindex="-1">{m.resume.sections.projects}</Eyebrow>
						<ul class={listClass}>
							{projects.map(item => (
								<li>
									<a class={linkRowClass} href={item.href} rel="noreferrer" target="_blank">
										<span class={railClass}>{month(item.date)}</span>
										<span class={linkBodyClass}>
											<span class={linkTitleClass}>{item.name}</span>
											<span class={linkSummaryClass}>{item.summary}</span>
										</span>
										<ArrowUpRight aria-hidden="true" class={linkArrowClass} />
									</a>
								</li>
							))}
						</ul>
					</section>

					<section class={sectionClass}>
						<Eyebrow as="h2" class={headingClass} id="skills" tabindex="-1">{m.resume.sections.skills}</Eyebrow>
						<ul class={listClass}>
							{skills.map(skill => (
								<li class={labelRowClass}>
									<span class="text-xs text-muted-foreground">{skill.group}</span>
									<TechList
										class="
											text-foreground
											print:text-sm/6
										"
										chipClass="text-xs text-foreground print:text-sm/6"
										items={skill.items}
										variant="chips"
									/>
								</li>
							))}
						</ul>
					</section>

					<section class={sectionClass}>
						<Eyebrow as="h2" class={headingClass} id="education" tabindex="-1">{m.resume.sections.education}</Eyebrow>
						<ul class={listClass}>
							{education.map(item => (
								<li class={labelRowClass}>
									<span class="text-xs text-muted-foreground">{item.degree}</span>
									<span class="text-sm/6 text-foreground">{item.school ? `${item.major} · ${item.school}` : item.major}</span>
								</li>
							))}
						</ul>
					</section>
				</StaggerReveal>
			</div>
		</Container>
	</section>
</RootLayout>

<script>
// Delegated once at module load, so it survives ClientRouter swaps without re-binding.
document.addEventListener('click', (event) => {
	if (event.target instanceof Element && event.target.closest('[data-resume-print]'))
		window.print()
})
</script>

<style is:global>
	/*
	 * A4 print: paper is always light, so the tokens the resume reads are pinned to
	 * their light values whatever theme is on screen; the site chrome drops out and
	 * the column takes the full printable width at a smaller root size.
	 */
	@media print {
		@page {
			size: A4;
			margin: 10mm 14mm;
		}

		:root:has([data-resume]) {
			color-scheme: light;
			font-size: 12px;
			--background: oklch(1 0 0);
			--foreground: oklch(0.17 0.003 260);
			--muted-foreground: oklch(0.45 0.004 260);
			--border: oklch(0 0 0 / 0.12);
			--highlight-brand: oklch(0.673 0.117 3);
			--highlight-text: oklch(0.56 0.13 3);
		}

		:root:has([data-resume]) body {
			min-height: 0;
			font-size: 1rem;
		}

		:root:has([data-resume]) :is(body > div, main) {
			min-height: 0;
			padding-top: 0;
		}

		:root:has([data-resume]) :is(footer, .custom-scrollbar) {
			display: none;
		}

		[data-resume] .page-shell {
			max-width: none;
			padding: 0;
		}

		/* Reveals wait for scroll; paper shows everything at rest. */
		[data-resume] :is([data-reveal], [data-stagger-reveal] > *) {
			opacity: 1 !important;
			filter: none !important;
			transform: none !important;
		}

		[data-resume] a {
			color: inherit;
			background-image: none;
		}

		/* Paper reads denser than a screen: one tighter rhythm for every line of copy. */
		[data-resume] :is(p, li, span) {
			line-height: 1.55;
		}

		[data-resume] :is(header, .resume-row, li li) {
			break-inside: avoid;
		}

		[data-resume] :is(h2, h3, h4) {
			break-after: avoid;
		}
	}
</style>
