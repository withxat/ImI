---
import type { Locale } from '@/lib/i18n/constants'

import { getImage, Image } from 'astro:assets'
import ArrowRight from '~icons/local/arrow-right'
import ArrowUpRight from '~icons/local/arrow-up-right'
import Smile from '~icons/lucide/smile'
import SiSwift from '~icons/simple-icons/swift'

import shinyImi from '@/assets/shiny-imi.png'
import AvatarPoke from '@/components/home/avatar-poke.astro'
import CodingPulse from '@/components/home/coding-pulse.astro'
import IntroBadgePopover from '@/components/home/intro-badge-popover.astro'
import NameAudioButton from '@/components/home/name-audio-button.astro'
import Container from '@/components/layout/container.astro'
import Eyebrow from '@/components/layout/eyebrow.astro'
import SiteHeader from '@/components/layout/site-header.astro'
import Wordmark from '@/components/layout/wordmark.astro'
import Seo from '@/components/meta/seo.astro'
import Reveal from '@/components/motion/reveal.astro'
import StaggerReveal from '@/components/motion/stagger-reveal.astro'
import PostIndexRow from '@/components/post/post-index-row.astro'
import RootLayout from '@/layouts/root-layout.astro'
import { formatPostMonth, formatPostMonthDay, getAllPosts } from '@/lib/blog'
import { htmlLangFor } from '@/lib/i18n/constants'
import { getIntroBadgeLabel } from '@/lib/i18n/intro-badges'
import { getMessages } from '@/lib/i18n/messages'
import { getCapabilities } from '@/lib/projects'
import { REPO_URL } from '@/lib/repo'
import { defaultOgImageUrl, personJsonLd, PROFILE_AVATAR_SRC, websiteJsonLd } from '@/lib/seo-data'
import { fetchCodingPulse } from '@/lib/tokens-ci/server'

const locale = (Astro.locals.locale ?? 'en') as Locale
const m = getMessages(locale)
const systemsLabel = getIntroBadgeLabel(locale, 'systems')
const productsLabel = getIntroBadgeLabel(locale, 'products')
// Only the first character after the badge sticks to it (a period, or ja's を), so the rest of the
// sentence can still wrap on a narrow screen.
const introAfterProducts = [...m.home.introAfterProducts]
const allPosts = await getAllPosts(locale)
const posts = allPosts.slice(0, 4)
const postsSpanMultipleYears = new Set(posts.map(post => post.date.getUTCFullYear())).size > 1
const baseCapabilities = await getCapabilities()
const allProjects = baseCapabilities
	.flatMap((cap, i) => {
		const copy = m.capabilities[i]
		return cap.items.map((item, j) => ({
			...item,
			description: copy?.items[j]?.description ?? item.description,
			title: copy?.items[j]?.title ?? item.title,
		}))
	})
	.reverse()

const SELECTED_TITLES = new Set(['Dash', 'Mikan', 'Rehype-Fluent-Emoji'])
const spotlightProject = allProjects.find(project => project.title === 'ImI')
const selectedProjects = allProjects.filter(project => SELECTED_TITLES.has(project.title))
const toolProjects = allProjects.filter(project => project.title !== 'ImI' && !SELECTED_TITLES.has(project.title))

const cardArrowClass = 'size-3.5 shrink-0 text-muted-foreground/70 transition-transform duration-150 ease-out group-hover/project:translate-x-0.5 group-hover/project:-translate-y-0.5 group-hover/project:text-highlight-strong motion-reduce:transition-none'
const waitUntil = Astro.locals.cfContext?.waitUntil.bind(Astro.locals.cfContext)
const [avatarImage, codingPulse] = await Promise.all([
	getImage({ height: 128, src: PROFILE_AVATAR_SRC, width: 128 }),
	fetchCodingPulse(waitUntil),
])
---

<RootLayout>
	<Seo
		jsonLd={[
			personJsonLd({ description: m.home.metaDescription }),
			websiteJsonLd({ description: m.home.metaDescription }),
		]}
		canonicalPath="/"
		description={m.home.metaDescription}
		image={defaultOgImageUrl(locale)}
		locale={locale}
		markdownPath="/llms.txt"
		slot="head"
		title={m.home.title}
		type="profile"
	>
		<link as="font" crossorigin="anonymous" href="/fonts/fugaz-one-regular-subset.woff2" rel="preload" type="font/woff2" />
		<link as="image" href={avatarImage.src} rel="preload" />
	</Seo>

	<section>
		<Container class="page-shell">
			<div class="flex flex-col">
				<div class="flex flex-col gap-4">
					<SiteHeader locale={locale} messages={m} />
					<div class="flex min-w-0 flex-col gap-4">
						<AvatarPoke copy={m.home.poke} />
						<div class="space-y-0">
							<div class="
								inline-flex items-baseline gap-2 text-2xl tracking-tight text-foreground
								sm:text-3xl
							"
							>
								<Wordmark as="h1" />
								<NameAudioButton label={m.home.playName} />
							</div>
							<p class="text-muted-foreground">{m.home.role}</p>
						</div>
					</div>
					<p
						class="home-bio-lead max-w-prose font-serif text-base/7 font-semibold text-foreground"
						lang={htmlLangFor(locale)}
					>
						{m.home.bioLead}
					</p>
				</div>

				<section class="mt-6">
					<StaggerReveal delayChildren={0.03} staggerChildren={0.045}>
						<div class="home-intro max-w-prose text-base/7 text-muted-foreground">
							{m.home.introBeforeSystems}
							<IntroBadgePopover kind="systems" label={systemsLabel} leading={!m.home.introBeforeSystems} locale={locale} />
							{m.home.introBetweenBadges}
							<span class="whitespace-nowrap"><IntroBadgePopover kind="products" label={productsLabel} locale={locale} />{introAfterProducts[0]}</span>{introAfterProducts.slice(1).join('')}
						</div>
					</StaggerReveal>
				</section>

				<section class="mt-20 space-y-4">
					<Reveal staggerIndex={0}>
						<div class="flex items-baseline justify-between gap-6">
							<Eyebrow as="h2" class="font-semibold">{m.home.writingEyebrow}</Eyebrow>
							<a class="text-link font-ui text-sm" href="/post" data-astro-prefetch>
								{m.home.viewAllPosts}
							</a>
						</div>
					</Reveal>
					<Reveal staggerIndex={1}>
						<ul class="divide-y divide-border border-y border-border">
							{posts.map(post => (
								<PostIndexRow
									dateLabel={postsSpanMultipleYears ? formatPostMonth(post.date) : formatPostMonthDay(post.date)}
									href={`/post/${post.slug}`}
									slug={post.slug}
									summary={post.summary}
									title={post.title}
								/>
							))}
						</ul>
					</Reveal>
				</section>

				<section class="mt-20 space-y-4">
					<Reveal staggerIndex={0}>
						<Eyebrow as="h2" class="font-semibold">{m.home.projectsEyebrow}</Eyebrow>
					</Reveal>
					<Reveal staggerIndex={1}>
						<div class="space-y-3">
							<article
								class="
									rounded-xl highlight-surface bg-popover p-4
									sm:p-5
									dark:border-highlight-brand/35 dark:bg-highlight-brand/4
								"
							>
								<div class="flex flex-wrap items-center gap-x-2 gap-y-1">
									<span class="inline-flex items-center gap-1.5 text-sm font-medium text-foreground">
										<Image
											alt=""
											class="size-4.5 shrink-0"
											densities={[1, 2]}
											height={20}
											src={shinyImi}
											width={20}
										/>
										<span>ImI</span>
									</span>
									<span aria-hidden="true" class="text-muted-foreground/50">·</span>
									<span class="text-sm text-muted-foreground">{m.home.spotlight.title}</span>
								</div>
								<p class="mt-2.5 text-sm/6 text-muted-foreground">
									{m.home.spotlight.description}
								</p>
								<div class="mt-4 flex flex-wrap items-center gap-2">
									<a
										class="
											group/pill inline-flex items-center gap-2 rounded-full border border-border bg-muted/70 px-3 py-1.5
											font-ui text-xs font-medium text-foreground transition-colors duration-150
											hover:border-highlight-soft hover:text-highlight-strong
										"
										href="/design"
										data-astro-prefetch
									>
										<span aria-hidden="true" class="inline-flex items-center gap-1">
											<span class="size-2 rounded-full bg-foreground" />
											<span class="size-2 rounded-full bg-highlight-brand" />
											<span class="size-2 rounded-full bg-highlight-soft" />
										</span>
										<span>{m.design.eyebrow}</span>
										<ArrowRight
											class="
												size-3 text-muted-foreground transition-transform duration-150 ease-out
												group-hover/pill:translate-x-0.5 group-hover/pill:text-highlight-strong
												motion-reduce:transition-none
											"
											aria-hidden="true"
										/>
									</a>
									<a
										class="
											group/pill inline-flex items-center gap-1.5 rounded-full border border-border bg-background/60 px-3 py-1.5
											font-ui text-xs text-muted-foreground transition-colors duration-150
											hover:border-highlight-soft hover:text-highlight-strong
										"
										href={spotlightProject?.link ?? REPO_URL}
										rel="noreferrer"
										target="_blank"
									>
										<span>{m.home.spotlight.source}</span>
										<ArrowUpRight
											class="
												size-3 transition-transform duration-150 ease-out
												group-hover/pill:translate-x-0.5 group-hover/pill:-translate-y-0.5 group-hover/pill:text-highlight-strong
												motion-reduce:transition-none
											"
											aria-hidden="true"
										/>
									</a>
								</div>
							</article>

							<ul class="
								grid gap-3
								@lg/page:grid-cols-3
							"
							>
								{selectedProjects.map(project => (
									<li class="min-w-0">
										<a
											class="
												group/project flex h-full flex-col gap-2 rounded-xl border border-border bg-popover p-3.5
												text-left transition-[border-color,box-shadow] duration-150 ease-out
												hover:border-highlight-soft hover:shadow-halo
												focus-visible:rounded-xl
												dark:hover:border-foreground/22 dark:hover:shadow-black/35
											"
											href={project.link}
											rel="noreferrer"
											target="_blank"
										>
											<div class="flex h-5 items-center justify-between gap-2">
												{project.title === 'Dash' && (
													<span class="inline-flex items-center gap-1.5 font-mono text-xs text-muted-foreground">
														<SiSwift aria-hidden="true" class="size-3.5" />
														<span>iOS</span>
													</span>
												)}
												{project.title === 'Mikan' && (
													<span aria-hidden="true" class="inline-flex items-center gap-1.5 font-mono text-xs text-muted-foreground">
														<span class="inline-flex w-4 flex-col gap-[2px] rounded-[3px] border border-border p-[2px]">
															<span class="block h-[2px] w-1.5 rounded-full bg-highlight-brand" />
															<span class="block h-[2px] w-full rounded-full bg-muted-foreground/50" />
															<span class="block h-[2px] w-2 rounded-full bg-muted-foreground/50" />
														</span>
														<span>Astro</span>
													</span>
												)}
												{project.title === 'Rehype-Fluent-Emoji' && (
													<span class="inline-flex items-center gap-1.5 font-mono text-xs text-muted-foreground">
														<Smile aria-hidden="true" class="size-3.5" />
														<span>U+1F600</span>
													</span>
												)}
												<ArrowUpRight aria-hidden="true" class={cardArrowClass} />
											</div>
											<span
												class="
													mt-0.5 text-sm font-medium wrap-break-word text-foreground transition-colors duration-150
													group-hover/project:text-highlight-strong
												"
											>
												{project.title}
											</span>
											<span class="text-xs/5 text-muted-foreground">
												{project.description}
											</span>
										</a>
									</li>
								))}
							</ul>

							{toolProjects.length > 0 && (
								<div class="flex flex-wrap items-center gap-x-3 gap-y-2 pt-2">
									<span class="font-ui text-xs text-muted-foreground">{m.home.toolsShelfLabel}</span>
									<ul class="flex flex-wrap items-center gap-2">
										{toolProjects.map(project => (
											<li>
												<a
													class="
														group/tool inline-flex items-center gap-1.5 rounded-full border border-border bg-popover px-3 py-1
														font-ui text-xs text-foreground/85 transition-[border-color,color] duration-150
														hover:border-highlight-soft hover:text-highlight-strong
														focus-visible:rounded-full
														dark:hover:border-foreground/22
													"
													href={project.link}
													rel="noreferrer"
													target="_blank"
													title={project.description}
												>
													<span>{project.title}</span>
													<ArrowUpRight
														class="
															size-3 shrink-0 text-muted-foreground/70 transition-transform duration-150 ease-out
															group-hover/tool:translate-x-0.5 group-hover/tool:-translate-y-0.5 group-hover/tool:text-highlight-strong
															motion-reduce:transition-none
														"
														aria-hidden="true"
													/>
												</a>
											</li>
										))}
									</ul>
								</div>
							)}
						</div>
					</Reveal>
				</section>

				{codingPulse && (
					<section class="mt-20">
						<Reveal staggerIndex={0}>
							<CodingPulse copy={m.home.codingPulse} data={codingPulse} />
						</Reveal>
					</section>
				)}
			</div>
		</Container>
	</section>
</RootLayout>
