---
import type { Locale } from '@/lib/i18n/constants'

import { Image } from 'astro:assets'
import ArrowUpRight from '~icons/local/arrow-up-right'

import IntroBadgePopover from '@/components/home/intro-badge-popover.astro'
import NameAudioButton from '@/components/home/name-audio-button.astro'
import Container from '@/components/layout/container.astro'
import Eyebrow from '@/components/layout/eyebrow.astro'
import SiteHeader from '@/components/layout/site-header.astro'
import Seo from '@/components/meta/seo.astro'
import Reveal from '@/components/motion/reveal.astro'
import StaggerReveal from '@/components/motion/stagger-reveal.astro'
import PostIndexRow from '@/components/post/post-index-row.astro'
import { Avatar, AvatarFallback, AvatarImage } from '@/components/ui/avatar'
import RootLayout from '@/layouts/root-layout.astro'
import { formatPostMonth, getAllPosts } from '@/lib/blog'
import { htmlLangFor } from '@/lib/i18n/constants'
import { getIntroBadgeLabel } from '@/lib/i18n/intro-badges'
import { getMessages } from '@/lib/i18n/messages'
import { getCapabilities } from '@/lib/projects'
import { DEFAULT_OG_IMAGE, personJsonLd, PROFILE_AVATAR_SRC, websiteJsonLd } from '@/lib/seo-data'

const locale = (Astro.locals.locale ?? 'en') as Locale
const m = getMessages(locale)
const systemsLabel = getIntroBadgeLabel(locale, 'systems')
const productsLabel = getIntroBadgeLabel(locale, 'products')
const allPosts = await getAllPosts(locale)
const posts = allPosts.slice(0, 4)
const baseCapabilities = await getCapabilities()
const projects = baseCapabilities
	.flatMap((cap, i) => {
		const copy = m.capabilities[i]
		return cap.items.map((item, j) => ({
			...item,
			description: copy?.items[j]?.description ?? item.description,
			title: copy?.items[j]?.title ?? item.title,
		}))
	})
	.reverse()

const projectIconClass = 'size-3.5 shrink-0 text-muted-foreground/70 transition-transform duration-150 ease-out group-hover/project:translate-x-0.5 group-hover/project:-translate-y-0.5 group-hover/project:text-highlight-strong'
---

<RootLayout>
	<Seo
		jsonLd={[
			personJsonLd({ description: m.home.metaDescription }),
			websiteJsonLd({ description: m.home.metaDescription }),
		]}
		canonicalPath="/"
		description={m.home.metaDescription}
		image={DEFAULT_OG_IMAGE}
		locale={locale}
		slot="head"
		title={m.home.title}
		type="profile"
	>
		<link as="font" crossorigin="anonymous" href="/fonts/fugaz-one-regular-subset.woff2" rel="preload" type="font/woff2" />
		<link as="image" href={PROFILE_AVATAR_SRC} rel="preload" />
	</Seo>

	<section>
		<Container class="page-shell">
			<div class="flex flex-col">
				<div class="flex flex-col gap-4">
					<SiteHeader locale={locale} messages={m} />
					<div class="flex min-w-0 flex-col gap-4">
						<Avatar class="
							size-14 rounded-xl border border-border
							after:rounded-xl
							sm:size-16
						"
						>
							<AvatarImage class="rounded-xl">
								<Image
									alt="Xat"
									class="size-full object-cover"
									fetchpriority="high"
									loading="eager"
									referrerpolicy="no-referrer"
									src={PROFILE_AVATAR_SRC}
									inferSize
								/>
							</AvatarImage>
							<AvatarFallback class="rounded-xl">X</AvatarFallback>
						</Avatar>
						<div class="space-y-0">
							<div class="
								inline-flex items-baseline gap-2 text-2xl tracking-tight text-foreground
								sm:text-3xl
							"
							>
								<h1 class="font-fugaz-one font-normal text-highlight-brand">Xat</h1>
								<NameAudioButton label={m.home.playName} />
							</div>
							<p class="text-muted-foreground">{m.home.role}</p>
						</div>
					</div>
					<p
						class="home-bio-lead max-w-prose font-serif text-base/7 font-semibold text-foreground"
						lang={htmlLangFor(locale)}
					>
						{m.home.bioLead}
					</p>
				</div>

				<section class="mt-6">
					<StaggerReveal delayChildren={0.03} staggerChildren={0.045}>
						<div class="max-w-prose text-base/7 text-muted-foreground">
							{m.home.introBeforeSystems}
							<IntroBadgePopover kind="systems" label={systemsLabel} locale={locale} />
							{m.home.introBetweenBadges}
							<span class="whitespace-nowrap"><IntroBadgePopover kind="products" label={productsLabel} locale={locale} />{m.home.introAfterProducts}</span>
						</div>
					</StaggerReveal>
				</section>

				<section class="mt-20 space-y-4">
					<Reveal staggerIndex={0}>
						<div class="flex items-baseline justify-between gap-6">
							<Eyebrow as="h2" class="font-semibold">{m.home.writingEyebrow}</Eyebrow>
							<a class="text-link font-ui text-sm" href="/post" data-astro-prefetch>
								{m.home.viewAllPosts}
							</a>
						</div>
					</Reveal>
					<Reveal staggerIndex={1}>
						<ul class="divide-y divide-border border-y border-border">
							{posts.map(post => (
								<PostIndexRow
									dateLabel={formatPostMonth(post.date)}
									href={`/post/${post.slug}`}
									slug={post.slug}
									summary={post.summary}
									title={post.title}
									prefetchOnView
								/>
							))}
						</ul>
					</Reveal>
				</section>

				<section class="mt-20 space-y-4">
					<Reveal staggerIndex={0}>
						<Eyebrow as="h2" class="font-semibold">{m.home.projectsEyebrow}</Eyebrow>
					</Reveal>
					<Reveal staggerIndex={1}>
						<ul class="divide-y divide-border border-y border-border">
							{projects.map(project => (
								<li>
									{project.link
										? (
												<a
													class="
														group/project flex flex-col gap-1 py-3.5 text-left transition-colors
														focus-visible:rounded-sm
														@lg/page:grid @lg/page:grid-cols-[12rem_minmax(0,1fr)_auto] @lg/page:items-baseline @lg/page:gap-x-6
													"
													href={project.link}
													rel="noreferrer"
													target="_blank"
												>
													<span class="
														text-sm font-medium text-foreground transition-colors duration-150
														group-hover/project:text-highlight-strong
													"
													>
														{project.title}
													</span>
													<span class="min-w-0 text-sm text-muted-foreground">{project.description}</span>
													<ArrowUpRight
														class={`
															hidden
															@lg/page:block
															${projectIconClass}
														`}
														aria-hidden="true"
													/>
												</a>
											)
										: (
												<div class="
													flex flex-col gap-1 py-3.5 text-left
													@lg/page:grid @lg/page:grid-cols-[12rem_minmax(0,1fr)] @lg/page:items-baseline @lg/page:gap-x-6
												"
												>
													<span class="text-sm font-medium text-foreground">{project.title}</span>
													<span class="min-w-0 text-sm text-muted-foreground">{project.description}</span>
												</div>
											)}
								</li>
							))}
						</ul>
					</Reveal>
				</section>
			</div>
		</Container>
	</section>
</RootLayout>
