{
	"extends": "@withxat/tsconfig",
	"compilerOptions": {
		"jsx": "preserve",
		"lib": ["ESNext", "DOM"],
		"rootDir": ".",
		"moduleResolution": "Bundler",
		"paths": {
			"@/*": ["./src/*"]
		},
		"allowImportingTsExtensions": true,
		"isolatedModules": true
	},
	"include": [
		".astro/types.d.ts",
		"src",
		"src/worker.ts",
		"astro.config.ts",
		"scripts",
		"src/**/*.astro"
	]
}
