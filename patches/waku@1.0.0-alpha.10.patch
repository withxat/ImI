+function normalizePreloadAsValues(stream) {
+    let carry = '';
+    const decoder = new TextDecoder();
+    const encoder = new TextEncoder();
+    return stream.pipeThrough(new TransformStream({
+        transform (chunk, controller) {
+            const text = carry + decoder.decode(chunk, {
+                stream: true
+            });
+            const emit = text.slice(0, -64);
+            carry = text.slice(-64);
+            if (emit) {
+                controller.enqueue(encoder.encode(normalizePreloadAsText(emit)));
+            }
+        },
+        flush (controller) {
+            const text = carry + decoder.decode();
+            if (text) {
+                controller.enqueue(encoder.encode(normalizePreloadAsText(text)));
+            }
+        }
+    }));
+}
